# Hermes Agent Railway Deployment - Environment Variables
# Copy this to Railway dashboard Variables tab, or use railway CLI:
# railway variables set --from-file .env.example

# =============================================================================
# REQUIRED: Telegram Bot Configuration
# =============================================================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated numeric Telegram user IDs allowed to use the bot
# Get your user ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Optional: Specific chat ID for notifications (if different from allowed users)
# Leave empty to auto-detect from incoming messages
TELEGRAM_CHAT_ID=

# =============================================================================
# REQUIRED: AI Provider API Keys (at least one)
# =============================================================================

# Option 1: Ollama Cloud (recommended - generous free tier)
# Get from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key

# Option 2: Groq (fallback - fast inference)
# Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Option 3: OpenCode Zen (free tier available)
# Get from https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================

# Provider: ollama-cloud, groq, or opencode-zen
MODEL_PROVIDER=ollama-cloud

# Default model for the chosen provider
# ollama-cloud: gemma4:31b-cloud, llama3.3:70b, etc.
# groq: llama-3.3-70b-versatile, qwen-2.5-72b, etc.
# opencode-zen: deepseek-v4-flash-free, big-pickle, minimax-m2.5-free
DEFAULT_MODEL=gemma4:31b-cloud

# Base URL for the provider (usually don't need to change)
# ollama-cloud: https://ollama.com/v1
# groq: https://api.groq.com/openai/v1
# opencode-zen: https://opencode.ai/zen/v1
BASE_URL=https://ollama.com/v1

# =============================================================================
# REQUIRED FOR BACKUP/RESTORE: GitHub Configuration
# =============================================================================

# GitHub Personal Access Token (classic) with 'repo' scope
# Create at: https://github.com/settings/tokens
# This is used to push/pull the data branch for backup/restore
GH_PAT=ghp_your_github_personal_access_token

# GitHub repository in format: owner/repo
# This repo will store the backup data branch
GH_REPO=yourusername/hermes-ondemand

# Git branch to use for data (default: main)
GH_REF=main

# Branch name for persistent data storage (created automatically)
DATA_BRANCH=railway-data

# =============================================================================
# OPTIONAL: Runtime Configuration
# =============================================================================

# Mode: gateway (full Hermes agent) or listener (lightweight trigger bot)
# gateway = full agent with all features, ~500MB RAM
# listener = lightweight bot that triggers GitHub Actions, ~100MB RAM
MODE=gateway

# Backup interval in seconds (default: 300 = 5 minutes)
BACKUP_EVERY_SEC=300

# Memory limits (Hermes internal settings)
# memory_char_limit: max chars in conversation memory
# user_char_limit: max chars in user profile memory
# These are set in config.yaml, not typically overridden here

# =============================================================================
# RAILWAY AUTO-PROVIDED (don't set manually)
# =============================================================================
# RAILWAY_SERVICE_NAME
# RAILWAY_ENVIRONMENT
# RAILWAY_PROJECT_ID
# RAILWAY_DEPLOYMENT_ID
# PORT (Railway assigns this automatically)