# Example environment file for the Pterodactyl listener (125MB RAM / 500MB disk)
# Copy to `listener/.env` and fill in your values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID(s), comma-separated. Empty = allow everyone (not recommended)
TELEGRAM_ALLOWED_USERS=

# GitHub Personal Access Token (classic, with repo scope) used to trigger the workflow
GH_PAT=

# GitHub repo in form owner/repo, e.g. you/hermes-ondemand
GH_REPO=

# Optional hardcoded Telegram chat id (if you don't rely on TELEGRAM_ALLOWED_USERS)
# Leave blank to auto-detect from incoming messages.
CHAT_ID=