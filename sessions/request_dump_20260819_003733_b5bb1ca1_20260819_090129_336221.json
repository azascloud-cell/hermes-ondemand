          "role": "tool",
          "content": "{\"content\": \"1|#!/usr/bin/env python3\\n2|# -*- coding: utf-8 -*-\\n3|\\\"\\\"\\\"\\n4|Ptero Akun Parent Manager — bot Pterodactyl untuk mengelola & memantau\\n5|kesehatan akun parent (cek IMAP, monitor otomatis, export akun sehat,\\n6|notifikasi Telegram).\\n7|\\n8|Perintah: add / list / check / auto / export / import / remove / set / stats / tg-test\\n9|\\\"\\\"\\\"\\n10|import argparse\\n11|import logging\\n12|import os\\n13|import sys\\n14|import time\\n15|from collections import Counter\\n16|from datetime import datetime\\n17|\\n18|from manager.database import AccountDB\\n19|from manager.exporter import export_accounts\\n20|from manager.health import check_one, run_checks\\n21|from manager.notifier import Notifier\\n22|from manager.utils import load_config, mask_email, now_iso, print_table, status_icon\\n23|\\n24|APP_DIR = os.path.dirname(os.path.abspath(__file__))\\n25|CONFIG_PATH = os.path.join(APP_DIR, \\\"config.json\\\")\\n26|DB_PATH = os.path.join(APP_DIR, \\\"accounts.json\\\")\\n27|LOG_DIR = os.path.join(APP_DIR, \\\"logs\\\")\\n28|\\n29|os.makedirs(LOG_DIR, exist_ok=True)\\n30|logging.basicConfig(\\n31|    level=logging.INFO,\\n32|    format=\\\"%(asctime)s [%(levelname)s] %(message)s\\\",\\n33|    handlers=[\\n34|        logging.StreamHandler(sys.stdout),\\n35|        logging.FileHandler(os.path.join(LOG_DIR, \\\"app.log\\\"), encoding=\\\"utf-8\\\"),\\n36|    ],\\n37|)\\n38|log = logging.getLogger(\\\"main\\\")\\n39|\\n40|BANNER = \\\"\\\"\\\"\\n41|\\\\033[1;36m\\n42| ╔══════════════════════════════════════════════════╗\\n43| ║      PTERO AKUN PARENT MANAGER  (bot monitor)    ║\\n44| ╚══════════════════════════════════════════════════╝\\\\033[0m\\\"\\\"\\\"\\n45|\\n46|\\n47|def green(s): return f\\\"\\\\033[32m{s}\\\\033[0m\\\"\\n48|def red(s): return f\\\"\\\\033[31m{s}\\\\033[0m\\\"\\n49|def yellow(s): return f\\\"\\\\033[33m{s}\\\\033[0m\\\"\\n50|def cyan(s): return f\\\"\\\\033[36m{s}\\\\033[0m\\\"\\n51|def bold(s): return f\\\"\\\\033[1m{s}\\\\033[0m\\\"\\n52|\\n53|\\n54|def to_ts(iso):\\n55|    try:\\n56|        return datetime.fromisoformat(iso).timestamp()\\n57|    except Exception:\\n58|        return 0\\n59|\\n60|\\n61|def update_and_report(db, accounts, results, cfg, notifier):\\n62|    \\\"\\\"\\\"Terapkan hasil check ke DB, cetak laporan, kirim notif perubahan status.\\\"\\\"\\\"\\n63|    threshold = int(cfg[\\\"check\\\"].get(\\\"consecutive_fail_threshold\\\", 1))\\n64|    n_healthy = n_bad = 0\\n65|    changed = []\\n66|    for acc, res in zip(accounts, results):\\n67|        em = acc[\\\"email\\\"]\\n68|        succeed = res[\\\"status\\\"] == \\\"ok\\\"\\n69|        if succeed:\\n70|            acc[\\\"fail_count\\\"] = 0\\n71|            new_status = \\\"healthy\\\"\\n72|            n_healthy += 1\\n73|        else:\\n74|            acc[\\\"fail_count\\\"] = int(acc.get(\\\"fail_count\\\") or 0) + 1\\n75|            prev = acc.get(\\\"status\\\", \\\"untested\\\")\\n76|            new_status = \\\"unhealthy\\\" if acc[\\\"fail_count\\\"] >= threshold else prev\\n77|            n_bad += 1\\n78|        acc[\\\"last_check\\\"] = now_iso()\\n79|        acc[\\\"last_result\\\"] = {\\n80|            \\\"status\\\": res[\\\"status\\\"],\\n81|            \\\"detail\\\": res[\\\"detail\\\"],\\n82|            \\\"latency_ms\\\": res[\\\"latency_ms\\\"],\\n83|        }\\n84|        old = acc.get(\\\"status\\\", \\\"untested\\\")\\n85|        if new_status != old:\\n86|            changed.append((em, old, new_status, res[\\\"detail\\\"], res[\\\"latency_ms\\\"]))\\n87|            acc[\\\"status\\\"] = new_status\\n88|            acc[\\\"last_changed\\\"] = now_iso()\\n89|        print(f\\\"{status_icon(new_status)} {em} — {res['detail']} ({res['latency_ms']} ms)\\\")\\n90|    db.save(accounts)\\n91|    total = len(accounts)\\n92|    line = f\\\"Ringkasan: {green(str(n_healthy))} sehat, {red(str(n_bad))} bermasalah dari {total} akun\\\"\\n93|    print(bold(line))\\n94|    log.info(\\\"Ringkasan check: %d sehat, %d bermasalah, %d total\\\", n_healthy, n_bad, total)\\n95|    for em, old, new, reason, lat in changed:\\n96|        notifier.alert_status(em, old, new, reason, lat)\\n97|\\n98|\\n99|def cmd_add(cfg, db, args):\\n100|    if \\\"@\\\" not in args.email:\\n101|        print(red(\\\"✖ Email tidak valid.\\\"))\\n102|        return 1\\n103|    if not args.password:\\n104|        print(red(\\\"✖ Password / app password wajib diisi (--password).\\\"))\\n105|        return 1\\n106|    ok, acc = db.add(\\n107|        email=args.email, password=args.password, recovery=args.recovery,\\n108|        proxy=args.proxy, imap_host=args.imap_host, imap_port=args.imap_port,\\n109|        note=args.note,\\n110|    )\\n111|    if not ok:\\n112|        print(yellow(f\\\"⚠  {mask_email(acc['email'])} sudah ada di database (status: {acc.get('status')}).\\\"))\\n113|        return 0\\n114|    print(green(f\\\"✅ Ditambahkan: {acc['email']} (status: untested)\\\"))\\n115|    if args.check:\\n116|        res = check_one(acc, cfg)\\n117|        update_and_report(db, [acc], [res], cfg, Notifier(cfg))\\n118|    return 0\\n119|\\n120|\\n121|def cmd_list(cfg, db, args):\\n122|    accounts = db.load()\\n123|    if args.status and args.status != \\\"all\\\":\\n124|        accounts = [a for a in accounts if str(a.get(\\\"status\\\", \\\"untested\\\")).lower() == args.status.lower()]\\n125|    if args.limit:\\n126|        accounts = accounts[: args.limit]\\n127|    if not accounts:\\n128|        print(yellow(\\\"Database kosong atau tidak ada yang cocok. Tambah: python3 main.py add --help\\\"))\\n129|        return 0\\n130|    rows = []\\n131|    for i, a in enumerate(accounts, 1):\\n132|        rows.append([\\n133|            str(i),\\n134|            a.get(\\\"email\\\", \\\"-\\\"),\\n135|            status_icon(a.get(\\\"status\\\", \\\"untested\\\")) + \\\" \\\" + str(a.get(\\\"status\\\", \\\"untested\\\")),\\n136|            str(a.get(\\\"fail_count\\\", 0)),\\n137|            a.get(\\\"recovery\\\") or \\\"-\\\",\\n138|            \\\"✋\\\" if a.get(\\\"paused\\\") else \\\"\\\",\\n139|            a.get(\\\"last_check\\\") or \\\"-\\\",\\n140|        ])\\n141|    print_table([\\\"#\\\", \\\"Email\\\", \\\"Status\\\", \\\"Gagal\\\", \\\"Recovery\\\", \\\"P\\\", \\\"Terakhir dicek\\\"], rows)\\n142|    print(f\\\"Total: {len(accounts)}\\\")\\n143|    return 0\\n144|\\n145|\\n146|def cmd_check(cfg, db, args):\\n147|    accounts = db.load()\\n148|    if not accounts:\\n149|        print(yellow(\\\"Database kosong. Tambah dulu: python3 main.py add --email ... --password ...\\\"))\\n150|        return 0\\n151|    print(cyan(f\\\"🔍 Memeriksa kesehatan {len(accounts)} akun via IMAP (concurrency: {cfg['check'].get('concurrency', 3)})...\\\"))\\n152|    results = run_checks(accounts, cfg)\\n153|    update_and_report(db, accounts, results, cfg, Notifier(cfg))\\n154|    return 0\\n155|\\n156|\\n157|def cmd_auto(cfg, db, args):\\n158|    interval = int(args.interval or cfg[\\\"check\\\"].get(\\\"interval_minutes\\\", 60))\\n159|    notifier = Notifier(cfg)\\n160|    print(BANNER)\\n161|    print(cyan(f\\\"🕐 Interval cek: {interval} menit | Log: logs/app.log | Telegram: {'ON' if notifier.enabled else 'OFF'}\\\"))\\n162|    print(yellow(\\\"Tekan Ctrl+C untuk berhenti.\\\\n\\\"))\\n163|    try:\\n164|        while True:\\n165|            accounts = db.load()\\n166|            now = time.time()\\n167|            due = []\\n168|            for a in accounts:\\n169|                if a.get(\\\"paused\\\"):\\n170|                    continue\\n171|                lc = a.get(\\\"last_check\\\") or \\\"\\\"\\n172|                age = (now - to_ts(lc)) if lc else (interval * 60 + 1)\\n173|                if age >= interval * 60:\\n174|                    due.append(a)\\n175|            if due:\\n176|                tick = f\\\"[{now_iso()}] Mengecek {len(due)} akun jatuh tempo...\\\"\\n177|                print(cyan(tick))\\n178|                log.info(tick)\\n179|                results = run_checks(due, cfg)\\n180|                update_and_report(db, due, results, cfg, notifier)\\n181|            else:\\n182|                print(f\\\"[{now_iso()}] Tidak ada akun jatuh tempo. Tidur 60 detik...\\\")\\n183|            time.sleep(60)\\n184|    except KeyboardInterrupt:\\n185|        print(\\\"\\\\n👋 Bot dihentikan. Sampai jumpa!\\\")\\n186|    return 0\\n187|\\n188|\\n189|def cmd_export(cfg, db, args):\\n190|    accounts = db.load()\\n191|    statuses = None\\n192|    if args.status and args.status.lower() != \\\"all\\\":\\n193|        statuses = [args.status.lower()]\\n194|    fmts = [\\\"csv\\\", \\\"json\\\"] if args.format == \\\"both\\\" else [args.format]\\n195|    for fmt in fmts:\\n196|        out = args.out or os.path.join(APP_DIR, f\\\"akun_{args.status or 'all'}.{fmt}\\\")\\n197|        n = export_accounts(accounts, out, fmt, statuses)\\n198|        print(green(f\\\"✅ {n} akun status '{args.status}' diexport ke {out}\\\"))\\n199|    return 0\\n200|\\n201|\\n202|def cmd_import(cfg, db, args):\\n203|    import csv as _csv\\n204|\\n205|    path = args.file\\n206|    if not os.path.exists(path):\\n207|        print(red(f\\\"✖ File tidak ditemukan: {path}\\\"))\\n208|        return 1\\n209|    added = skipped = 0\\n210|    with open(path, newline=\\\"\\\", encoding=\\\"utf-8-sig\\\") as f:\\n211|        for row in _csv.DictReader(f):\\n212|            email = (row.get(\\\"email\\\") or \\\"\\\").strip()\\n213|            if not email or \\\"@\\\" not in email:\\n214|                continue\\n215|            ok, _ = db.add(\\n216|                email=email,\\n217|                password=(row.get(\\\"password\\\") or \\\"\\\").strip(),\\n218|                recovery=(row.get(\\\"recovery\\\") or \\\"\\\").strip(),\\n219|                proxy=(row.get(\\\"proxy\\\") or \\\"\\\").strip(),\\n220|                imap_host=(row.get(\\\"imap_host\\\") or \\\"\\\").strip(),\\n221|                imap_port=(row.get(\\\"imap_port\\\") or \\\"\\\").strip(),\\n222|                note=(row.get(\\\"note\\\") or \\\"\\\").strip(),\\n223|            )\\n224|            if ok:\\n225|                added += 1\\n226|            else:\\n227|                skipped += 1\\n228|    print(green(f\\\"✅ Import selesai: {added} ditambahkan, {skipped} dilewati (duplikat).\\\"))\\n229|    return 0\\n230|\\n231|\\n232|def cmd_remove(cfg, db, args):\\n233|    if not db.find(args.email):\\n234|        print(yellow(\\\"Akun tidak ditemukan.\\\"))\\n235|        return 1\\n236|    if not args.yes:\\n237|        ans = input(f\\\"Hapus {args.email}? (y/N): \\\").strip().lower()\\n238|        if ans != \\\"y\\\":\\n239|            print(\\\"Dibatalkan.\\\")\\n240|            return 0\\n241|    db.remove(args.email)\\n242|    print(green(f\\\"🗑  {args.email} dihapus.\\\"))\\n243|    return 0\\n244|\\n245|\\n246|def cmd_set(cfg, db, args):\\n247|    if not db.find(args.email):\\n248|        print(yellow(\\\"Akun tidak ditemukan.\\\"))\\n249|        return 1\\n250|    updates = {}\\n251|    if args.status:\\n252|        st = args.status.lower()\\n253|        if st not in (\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\"):\\n254|            print(red(\\\"Status harus: healthy / unhealthy / untested\\\"))\\n255|            return 1\\n256|        updates[\\\"status\\\"] = st\\n257|    if args.paused is not None:\\n258|        updates[\\\"paused\\\"] = args.paused.lower() in (\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"ya\\\")\\n259|    if args.note is not None:\\n260|        updates[\\\"note\\\"] = args.note\\n261|    if args.password:\\n262|        updates[\\\"password\\\"] = args.password\\n263|    if not updates:\\n264|        print(yellow(\\\"Tidak ada perubahan yang diminta.\\\"))\\n265|        return 0\\n266|    db.update(args.email, **updates)\\n267|    print(green(f\\\"✅ {args.email} diperbarui: {updates}\\\"))\\n268|    return 0\\n269|\\n270|\\n271|def cmd_stats(cfg, db, args):\\n272|    accounts = db.load()\\n273|    c = Counter(str(a.get(\\\"status\\\", \\\"untested\\\")) for a in accounts)\\n274|    total = len(accounts)\\n275|    paused = sum(1 for a in accounts if a.get(\\\"paused\\\"))\\n276|    last = max((a.get(\\\"last_check\\\") or \\\"\\\" for a in accounts), default=\\\"-\\\")\\n277|    print(bold(f\\\"📊 Total akun: {total}\\\"))\\n278|    for st in (\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\"):\\n279|        print(f\\\"  {status_icon(st)} {st}: {c.get(st, 0)}\\\")\\n280|    print(f\\\"  ✋ paused: {paused}\\\")\\n281|    print(f\\\"  🕒 check terakhir: {last}\\\")\\n282|    if c.get(\\\"healthy\\\"):\\n283|        print(bold(f\\\"Persentase sehat: {100.0 * c['healthy'] / total:.1f}%\\\"))\\n284|    return 0\\n285|\\n286|\\n287|def cmd_tgtest(cfg, db, args):\\n288|    n = Notifier(cfg)\\n289|    if not n.enabled:\\n290|        print(yellow(\\\"Telegram belum dikonfigurasi. Isi config.json → telegram, atau env TG_BOT_TOKEN / TG_CHAT_ID. Lihat README.\\\"))\\n291|        return 1\\n292|    ok = n.send(\\\"✅ Test notifikasi dari <b>Ptero Akun Parent Manager</b>\\\")\\n293|    print(green(\\\"Terikirim ✅\\\") if ok else red(\\\"Gagal kirim ✖ — cek token/chat id dan log.\\\"))\\n294|    return 0 if ok else 1\\n295|\\n296|\\n297|def build_parser():\\n298|    p = argparse.ArgumentParser(prog=\\\"main.py\\\", description=\\\"🎯 Bot Pterodactyl manajemen akun parent (cek kesehatan, auto-monitor, export akun sehat)\\\")\\n299|    sub = p.add_subparsers(dest=\\\"cmd\\\", metavar=\\\"perintah\\\")\\n300|\\n301|    a = sub.add_parser(\\\"add\\\", help=\\\"Tambah akun parent\\\")\\n302|    a.add_argument(\\\"--email\\\", required=True)\\n303|    a.add_argument(\\\"--password\\\", required=True, help=\\\"Password atau app password (Gmail wajib app password)\\\")\\n304|    a.add_argument(\\\"--recovery\\\", help=\\\"Email recovery (outlook/proton/dll)\\\")\\n305|    a.add_argument(\\\"--proxy\\\", help=\\\"Proxy opsional, format: socks5://user:pass@host:port\\\")\\n306|    a.add_argument(\\\"--imap-host\\\", help=\\\"Host IMAP kustom (default: imap.gmail.com)\\\")\\n307|    a.add_argument(\\\"--imap-port\\\", help=\\\"Port IMAP (default: 993)\\\")\\n308|    a.add_argument(\\\"--note\\\", help=\\\"Catatan (mis. nomor urut anak, dsb.)\\\")\\n309|    a.add_argument(\\\"--check\\\", action=\\\"store_true\\\", help=\\\"Langsung cek setelah ditambahkan\\\")\\n310|    a.set_defaults(func=cmd_add)\\n311|\\n312|    a = sub.add_parser(\\\"list\\\", help=\\\"Lihat daftar akun\\\")\\n313|    a.add_argument(\\\"--status\\\", choices=[\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\", \\\"all\\\"], default=\\\"all\\\")\\n314|    a.add_argument(\\\"--limit\\\", type=int, help=\\\"Batasi jumlah baris\\\")\\n315|    a.set_defaults(func=cmd_list)\\n316|\\n317|    a = sub.add_parser(\\\"check\\\", help=\\\"Cek sekali semua akun (manual)\\\")\\n318|    a.set_defaults(func=cmd_check)\\n319|\\n320|    a = sub.add_parser(\\\"auto\\\", help=\\\"Mode monitor: cek berkala terus-menerus\\\")\\n321|    a.add_argument(\\\"--interval\\\", type=int, help=\\\"Menit antar pengecekan (default dari config.json)\\\")\\n322|    a.set_defaults(func=cmd_auto)\\n323|\\n324|    a = sub.add_parser(\\\"export\\\", help=\\\"Export akun (default: yang masih sehat)\\\")\\n325|    a.add_argument(\\\"--status\\\", default=\\\"healthy\\\", help=\\\"healthy / unhealthy / untested / all\\\")\\n326|    a.add_argument(\\\"--format\\\", choices=[\\\"csv\\\", \\\"json\\\", \\\"both\\\"], default=\\\"both\\\")\\n327|    a.add_argument(\\\"--out\\\", help=\\\"Nama file output (untuk format tunggal)\\\")\\n328|    a.set_defaults(func=cmd_export)\\n329|\\n330|    a = sub.add_parser(\\\"import\\\", help=\\\"Import massal dari CSV\\\")\\n331|    a.add_argument(\\\"--file\\\", required=True, help=\\\"CSV kolom: email,password,recovery,proxy,imap_host,imap_port,note\\\")\\n332|    a.set_defaults(func=cmd_import)\\n333|\\n334|    a = sub.add_parser(\\\"remove\\\", help=\\\"Hapus akun\\\")\\n335|    a.add_argument(\\\"--email\\\", required=True)\\n336|    a.add_argument(\\\"--yes\\\", action=\\\"store_true\\\", help=\\\"Tanpa konfirmasi\\\")\\n337|    a.set_defaults(func=cmd_remove)\\n338|\\n339|    a = sub.add_parser(\\\"set\\\", help=\\\"Ubah status / paused / note akun\\\")\\n340|    a.add_argument(\\\"--email\\\", required=True)\\n341|    a.add_argument(\\\"--status\\\", help=\\\"healthy / unhealthy / untested\\\")\\n342|    a.add_argument(\\\"--paused\\\", help=\\\"true/false — skip dari auto check\\\")\\n343|    a.add_argument(\\\"--note\\\", help=\\\"Ganti catatan\\\")\\n344|    a.add_argument(\\\"--password\\\", help=\\\"Ganti password/app password\\\")\\n345|    a.set_defaults(func=cmd_set)\\n346|\\n347|    a = sub.add_parser(\\\"stats\\\", help=\\\"Statistik database\\\")\\n348|    a.set_defaults(func=cmd_stats)\\n349|\\n350|    a = sub.add_parser(\\\"tg-test\\\", help=\\\"Kirim notifikasi uji ke Telegram\\\")\\n351|    a.set_defaults(func=cmd_tgtest)\\n352|\\n353|    return p\\n354|\\n355|\\n356|def main():\\n357|    parser = build_parser()\\n358|    args = parser.parse_args()\\n359|    if not getattr(args, \\\"cmd\\\", None):\\n360|        parser.print_help()\\n361|        return 0\\n362|    cfg = load_config(CONFIG_PATH)\\n363|    db_path = cfg.get(\\\"db_file\\\") or DB_PATH\\n364|    if not os.path.isabs(db_path):\\n365|        db_path = os.path.join(APP_DIR, db_path)\\n366|    db = AccountDB(db_path)\\n367|    return args.func(cfg, db, args)\\n368|\\n369|\\n370|if __name__ == \\\"__main__\\\":\\n371|    sys.exit(main())\", \"total_lines\": 370, \"file_size\": 14250, \"truncated\": false, \"is_binary\": false, \"is_image\": false}",
