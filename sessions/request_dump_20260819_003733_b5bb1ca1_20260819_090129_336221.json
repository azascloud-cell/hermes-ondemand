              "type": "function",
              "function": {
                "name": "write_file",
                "arguments": "{\"content\":\"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"\\nTelegram Bot Handler \\u2014 command & conversation flow untuk manajemen akun parent.\\n- /start, /help, /list, /check, /export, /stats, /tgtest\\n- /add \\u2192 conversation: email \\u2192 password \\u2192 recovery \\u2192 proxy (opsional) \\u2192 confirm\\n- /import \\u2192 reply CSV file\\n- /delete <email> \\u2192 konfirmasi\\n- /set <email> \\u2192 pilih field (status/paused/note/proxy/password)\\n- Auto-delete pesan berisi kredensial setelah sukses\\n\\\"\\\"\\\"\\nimport logging\\nimport os\\nimport re\\nimport threading\\nimport time\\nfrom datetime import datetime\\nfrom pathlib import Path\\n\\nfrom telegram import Update, ReplyKeyboardMarkup, ReplyKeyboardRemove\\nfrom telegram.ext import (\\n    Application,\\n    CommandHandler,\\n    MessageHandler,\\n    ConversationHandler,\\n    ContextTypes,\\n    filters,\\n)\\n\\nfrom manager.database import AccountDB\\nfrom manager.health import check_one\\nfrom manager.exporter import export_accounts\\nfrom manager.notifier import Notifier\\nfrom manager.utils import load_config, mask_email, now_iso, status_icon, print_table\\n\\nlog = logging.getLogger(\\\"telegram_bot\\\")\\n\\n# Conversation states\\nADD_EMAIL, ADD_PASSWORD, ADD_RECOVERY, ADD_PROXY, ADD_CONFIRM = range(5)\\nIMPORT_FILE = range(5, 6)[0]\\nDELETE_CONFIRM = range(6, 7)[0]\\nSET_FIELD, SET_VALUE = range(7, 9)\\n\\n# Hanya user ini yang boleh kontrol (set di config.json \\u2192 telegram.admin_user_id)\\ndef is_authorized(update: Update, cfg) -> bool:\\n    admin_id = str(cfg.get(\\\"telegram\\\", {}).get(\\\"admin_user_id\\\", \\\"\\\"))\\n    if not admin_id:\\n        return True  # Kalau nggak diset, allow all (fallback)\\n    return str(update.effective_user.id) == admin_id\\n\\n\\ndef auth_guard(handler):\\n    \\\"\\\"\\\"Decorator: cek authorization sebelum jalanin handler.\\\"\\\"\\\"\\n    async def wrapper(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n        cfg = context.bot_data.get(\\\"cfg\\\")\\n        if not is_authorized(update, cfg):\\n            await update.message.reply_text(\\\"\\u26d4 Tidak diizinkan.\\\")\\n            return ConversationHandler.END\\n        return await handler(update, context)\\n    return wrapper\\n\\n\\n# ===================== UTIL =====================\\ndef build_main_keyboard():\\n    return ReplyKeyboardMarkup(\\n        [\\n            [\\\"/list\\\", \\\"/check\\\"],\\n            [\\\"/add\\\", \\\"/import\\\"],\\n            [\\\"/export\\\", \\\"/stats\\\"],\\n            [\\\"/delete\\\", \\\"/set\\\"],\\n            [\\\"/tgtest\\\", \\\"/help\\\"],\\n        ],\\n        resize_keyboard=True,\\n        one_time_keyboard=False,\\n    )\\n\\n\\nasync def safe_delete_message(context: ContextTypes.DEFAULT_TYPE, chat_id: int, message_id: int):\\n    \\\"\\\"\\\"Hapus pesan dengan error handling.\\\"\\\"\\\"\\n    try:\\n        await context.bot.delete_message(chat_id=chat_id, message_id=message_id)\\n    except Exception as e:\\n        log.debug(\\\"Gagal hapus pesan %s: %s\\\", message_id, e)\\n\\n\\nasync def send_temp(context: ContextTypes.DEFAULT_TYPE, chat_id: int, text: str, parse_mode=\\\"HTML\\\", delay=5):\\n    \\\"\\\"\\\"Kirim pesan lalu hapus otomatis setelah `delay` detik.\\\"\\\"\\\"\\n    msg = await context.bot.send_message(chat_id=chat_id, text=text, parse_mode=parse_mode)\\n    async def _del():\\n        await asyncio.sleep(delay)\\n        await safe_delete_message(context, chat_id, msg.message_id)\\n    asyncio.create_task(_del())\\n    return msg\\n\\n\\n# ===================== COMMAND HANDLERS =====================\\n@auth_guard\\nasync def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    await update.message.reply_text(\\n        \\\"\\ud83e\\udd16 <b>Ptero Akun Parent Manager</b>\\\\n\\\"\\n        \\\"Bot monitor kesehatan akun parent (IMAP) + manajemen via Telegram.\\\\n\\\\n\\\"\\n        \\\"Perintah cepat:\\\\n\\\"\\n        \\\"\\u2022 /list \\u2014 daftar akun\\\\n\\\"\\n        \\\"\\u2022 /check \\u2014 cek manual sekali\\\\n\\\"\\n        \\\"\\u2022 /add \\u2014 tambah akun (conversation)\\\\n\\\"\\n        \\\"\\u2022 /import \\u2014 import CSV (reply file)\\\\n\\\"\\n        \\\"\\u2022 /export \\u2014 export yg sehat\\\\n\\\"\\n        \\\"\\u2022 /stats \\u2014 statistik\\\\n\\\"\\n        \\\"\\u2022 /delete <email> \\u2014 hapus akun\\\\n\\\"\\n        \\\"\\u2022 /set <email> \\u2014 ubah status/paused/note/proxy/password\\\\n\\\"\\n        \\\"\\u2022 /tgtest \\u2014 tes notifikasi\\\\n\\\\n\\\"\\n        \\\"\\u26a0\\ufe0f Pesan kredensial (password/proxy) akan <b>dihapus otomatis</b> setelah verifikasi.\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=build_main_keyboard(),\\n    )\\n\\n\\n@auth_guard\\nasync def cmd_help(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    await cmd_start(update, context)\\n\\n\\n@auth_guard\\nasync def cmd_list(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    accounts = db.load()\\n    if not accounts:\\n        await update.message.reply_text(\\\"\\ud83d\\udced Database kosong. Tambah: /add\\\")\\n        return\\n    rows = []\\n    for i, a in enumerate(accounts, 1):\\n        rows.append(\\n            f\\\"{i}. {status_icon(a.get('status', 'untested'))} <code>{mask_email(a.get('email', '-'))}</code> \\\"\\n            f\\\"| {a.get('status', 'untested')} | Gagal: {a.get('fail_count', 0)} | \\\"\\n            f\\\"Recovery: {a.get('recovery') or '-'}\\\"\\n        )\\n    text = \\\"\\ud83d\\udccb <b>Daftar Akun Parent</b>\\\\n\\\\n\\\" + \\\"\\\\n\\\".join(rows)\\n    if len(text) > 4000:\\n        # Kirim per chunk\\n        for i in range(0, len(rows), 30):\\n            chunk = \\\"\\ud83d\\udccb <b>Daftar Akun Parent</b>\\\\n\\\\n\\\" + \\\"\\\\n\\\".join(rows[i:i+30])\\n            await update.message.reply_text(chunk, parse_mode=\\\"HTML\\\")\\n    else:\\n        await update.message.reply_text(text, parse_mode=\\\"HTML\\\")\\n\\n\\n@auth_guard\\nasync def cmd_check(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    notifier = context.bot_data[\\\"notifier\\\"]\\n    accounts = db.load()\\n    if not accounts:\\n        await update.message.reply_text(\\\"\\ud83d\\udced Database kosong.\\\")\\n        return\\n    msg = await update.message.reply_text(f\\\"\\ud83d\\udd0d Memeriksa {len(accounts)} akun via IMAP...\\\")\\n    results = []\\n    for acc in accounts:\\n        res = check_one(acc, cfg)\\n        results.append(res)\\n        # Update DB inline\\n        if res[\\\"status\\\"] == \\\"ok\\\":\\n            acc[\\\"fail_count\\\"] = 0\\n            acc[\\\"status\\\"] = \\\"healthy\\\"\\n        else:\\n            acc[\\\"fail_count\\\"] = acc.get(\\\"fail_count\\\", 0) + 1\\n            if acc[\\\"fail_count\\\"] >= cfg[\\\"check\\\"].get(\\\"consecutive_fail_threshold\\\", 1):\\n                acc[\\\"status\\\"] = \\\"unhealthy\\\"\\n        acc[\\\"last_check\\\"] = now_iso()\\n        acc[\\\"last_result\\\"] = res\\n    db.save(accounts)\\n    n_healthy = sum(1 for r in results if r[\\\"status\\\"] == \\\"ok\\\")\\n    n_bad = len(results) - n_healthy\\n    await msg.edit_text(\\n        f\\\"\\u2705 <b>Check selesai</b>\\\\n\\\"\\n        f\\\"\\ud83d\\udfe2 Sehat: {n_healthy} | \\ud83d\\udd34 Bermasalah: {n_bad} | Total: {len(accounts)}\\\"\\n    )\\n    # Kirim notif perubahan status via notifier (sudah handle di update_and_report tapi ini manual)\\n    for acc, res in zip(accounts, results):\\n        old = \\\"untested\\\"  # simplified\\n        if res[\\\"status\\\"] != \\\"ok\\\" and acc.get(\\\"status\\\") == \\\"unhealthy\\\":\\n            notifier.alert_status(acc[\\\"email\\\"], old, \\\"unhealthy\\\", res[\\\"detail\\\"], res[\\\"latency_ms\\\"])\\n\\n\\n@auth_guard\\nasync def cmd_export(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    accounts = db.load()\\n    statuses = [\\\"healthy\\\"]\\n    rows = [a for a in accounts if str(a.get(\\\"status\\\", \\\"\\\")).lower() in statuses]\\n    if not rows:\\n        await update.message.reply_text(\\\"\\ud83d\\udced Tidak ada akun sehat.\\\")\\n        return\\n    out_csv = f\\\"akun_healthy_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv\\\"\\n    out_json = out_csv.replace(\\\".csv\\\", \\\".json\\\")\\n    n_csv = export_accounts(rows, out_csv, \\\"csv\\\", statuses)\\n    n_json = export_accounts(rows, out_json, \\\"json\\\", statuses)\\n    await update.message.reply_document(document=open(out_csv, \\\"rb\\\"), caption=f\\\"\\u2705 {n_csv} akun sehat (CSV)\\\")\\n    await update.message.reply_document(document=open(out_json, \\\"rb\\\"), caption=f\\\"\\u2705 {n_json} akun sehat (JSON)\\\")\\n    # Hapus file lokal\\n    Path(out_csv).unlink(missing_ok=True)\\n    Path(out_json).unlink(missing_ok=True)\\n\\n\\n@auth_guard\\nasync def cmd_stats(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    db = context.bot_data[\\\"db\\\"]\\n    accounts = db.load()\\n    from collections import Counter\\n    c = Counter(str(a.get(\\\"status\\\", \\\"untested\\\")) for a in accounts)\\n    total = len(accounts)\\n    paused = sum(1 for a in accounts if a.get(\\\"paused\\\"))\\n    last = max((a.get(\\\"last_check\\\") or \\\"\\\" for a in accounts), default=\\\"-\\\")\\n    text = (\\n        f\\\"\\ud83d\\udcca <b>Statistik</b>\\\\n\\\"\\n        f\\\"Total: {total}\\\\n\\\"\\n        f\\\"\\u2705 Sehat: {c.get('healthy', 0)}\\\\n\\\"\\n        f\\\"\\ud83d\\udd34 Bermasalah: {c.get('unhealthy', 0)}\\\\n\\\"\\n        f\\\"\\u2b1c Belum cek: {c.get('untested', 0)}\\\\n\\\"\\n        f\\\"\\u23f8 Pause: {paused}\\\\n\\\"\\n        f\\\"\\ud83d\\udd52 Last check: {last}\\\\n\\\"\\n    )\\n    if c.get(\\\"healthy\\\") and total:\\n        text += f\\\"\\ud83d\\udcc8 Persentase sehat: {100.0 * c['healthy'] / total:.1f}%\\\"\\n    await update.message.reply_text(text, parse_mode=\\\"HTML\\\")\\n\\n\\n@auth_guard\\nasync def cmd_tgtest(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    notifier = context.bot_data[\\\"notifier\\\"]\\n    ok = notifier.send(\\\"\\u2705 Test notifikasi dari <b>Ptero Akun Parent Manager</b>\\\")\\n    await update.message.reply_text(\\\"\\u2705 Terkirim\\\" if ok else \\\"\\u274c Gagal \\u2014 cek token/chat_id\\\")\\n\\n\\n# ===================== CONVERSATION: /add =====================\\n@auth_guard\\nasync def add_start(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    await update.message.reply_text(\\n        \\\"\\u2795 <b>Tambah Akun Parent</b>\\\\n\\\\n\\\"\\n        \\\"Step 1/5: Kirim <b>email</b> akun parent (contoh: parent@gmail.com)\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=ReplyKeyboardRemove(),\\n    )\\n    return ADD_EMAIL\\n\\n\\n@auth_guard\\nasync def add_email(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    email = update.message.text.strip()\\n    if \\\"@\\\" not in email:\\n        await update.message.reply_text(\\\"\\u274c Email tidak valid. Kirim ulang:\\\")\\n        return ADD_EMAIL\\n    context.user_data[\\\"add_email\\\"] = email\\n    # Hapus pesan user (email)\\n    await safe_delete_message(context, update.effective_chat.id, update.message.message_id)\\n    await update.message.reply_text(\\n        f\\\"\\u2705 Email: <code>{mask_email(email)}</code>\\\\n\\\\n\\\"\\n        \\\"Step 2/5: Kirim <b>password / app password</b> (Gmail wajib App Password)\\\",\\n        parse_mode=\\\"HTML\\\",\\n    )\\n    return ADD_PASSWORD\\n\\n\\n@auth_guard\\nasync def add_password(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    pwd = update.message.text.strip()\\n    if not pwd:\\n        await update.message.reply_text(\\\"\\u274c Password tidak boleh kosong. Kirim ulang:\\\")\\n        return ADD_PASSWORD\\n    context.user_data[\\\"add_password\\\"] = pwd\\n    # HAPUS PESAN PASSWORD SEGERA\\n    await safe_delete_message(context, update.effective_chat.id, update.message.message_id)\\n    await update.message.reply_text(\\n        \\\"\\u2705 Password diterima (dihapus).\\\\n\\\\n\\\"\\n        \\\"Step 3/5: Kirim <b>email recovery</b> (opsional, kosongkan dengan '-')\\\",\\n        parse_mode=\\\"HTML\\\",\\n    )\\n    return ADD_RECOVERY\\n\\n\\n@auth_guard\\nasync def add_recovery(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    rec = update.message.text.strip()\\n    context.user_data[\\\"add_recovery\\\"] = rec if rec != \\\"-\\\" else \\\"\\\"\\n    await safe_delete_message(context, update.effective_chat.id, update.message.message_id)\\n    await update.message.reply_text(\\n        \\\"\\u2705 Recovery diterima.\\\\n\\\\n\\\"\\n        \\\"Step 4/5: Kirim <b>proxy SOCKS5</b> (opsional, format: <code>socks5://user:pass@host:port</code>, kosongkan dengan '-')\\\",\\n        parse_mode=\\\"HTML\\\",\\n    )\\n    return ADD_PROXY\\n\\n\\n@auth_guard\\nasync def add_proxy(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    proxy = update.message.text.strip()\\n    context.user_data[\\\"add_proxy\\\"] = proxy if proxy != \\\"-\\\" else \\\"\\\"\\n    if proxy and proxy != \\\"-\\\":\\n        await safe_delete_message(context, update.effective_chat.id, update.message.message_id)\\n    await update.message.reply_text(\\n        \\\"\\u2705 Proxy diterima.\\\\n\\\\n\\\"\\n        \\\"Step 5/5: <b>Konfirmasi</b>\\\\n\\\"\\n        f\\\"Email: <code>{mask_email(context.user_data['add_email'])}</code>\\\\n\\\"\\n        f\\\"Recovery: {context.user_data['add_recovery'] or '-'}\\\\n\\\"\\n        f\\\"Proxy: {context.user_data['add_proxy'] or '-'}\\\\n\\\\n\\\"\\n        \\\"Kirim <b>YA</b> untuk simpan & cek sekarang, atau <b>BATAL</b>.\\\",\\n        parse_mode=\\\"HTML\\\",\\n    )\\n    return ADD_CONFIRM\\n\\n\\n@auth_guard\\nasync def add_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    ans = update.message.text.strip().lower()\\n    if ans not in (\\\"ya\\\", \\\"y\\\", \\\"yes\\\"):\\n        await update.message.reply_text(\\\"\\u274c Dibatalkan.\\\", reply_markup=build_main_keyboard())\\n        return ConversationHandler.END\\n\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    notifier = context.bot_data[\\\"notifier\\\"]\\n\\n    ok, acc = db.add(\\n        email=context.user_data[\\\"add_email\\\"],\\n        password=context.user_data[\\\"add_password\\\"],\\n        recovery=context.user_data[\\\"add_recovery\\\"],\\n        proxy=context.user_data[\\\"add_proxy\\\"],\\n    )\\n    if not ok:\\n        await update.message.reply_text(\\n            f\\\"\\u26a0\\ufe0f {mask_email(acc['email'])} sudah ada (status: {acc.get('status')}).\\\",\\n            reply_markup=build_main_keyboard(),\\n        )\\n        return ConversationHandler.END\\n\\n    # Cek langsung\\n    res = check_one(acc, cfg)\\n    acc[\\\"last_check\\\"] = now_iso()\\n    acc[\\\"last_result\\\"] = res\\n    if res[\\\"status\\\"] == \\\"ok\\\":\\n        acc[\\\"fail_count\\\"] = 0\\n        acc[\\\"status\\\"] = \\\"healthy\\\"\\n    else:\\n        acc[\\\"fail_count\\\"] = 1\\n        acc[\\\"status\\\"] = \\\"unhealthy\\\"\\n    db.save([acc])\\n\\n    status_text = \\\"\\u2705 <b>SEHAT</b>\\\" if res[\\\"status\\\"] == \\\"ok\\\" else f\\\"\\u274c <b>BERMASALAH</b> \\u2014 {res['detail']}\\\"\\n    await update.message.reply_text(\\n        f\\\"\\u2705 Akun ditambahkan & dicek!\\\\n\\\\n\\\"\\n        f\\\"Email: <code>{mask_email(acc['email'])}</code>\\\\n\\\"\\n        f\\\"Status: {status_text}\\\\n\\\"\\n        f\\\"Latensi: {res['latency_ms']} ms\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=build_main_keyboard(),\\n    )\\n    # Notif kalau bermasalah\\n    if res[\\\"status\\\"] != \\\"ok\\\":\\n        notifier.alert_status(acc[\\\"email\\\"], \\\"untested\\\", \\\"unhealthy\\\", res[\\\"detail\\\"], res[\\\"latency_ms\\\"])\\n\\n    # Bersihkan user_data\\n    context.user_data.clear()\\n    return ConversationHandler.END\\n\\n\\n# ===================== CONVERSATION: /import =====================\\n@auth_guard\\nasync def import_start(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    await update.message.reply_text(\\n        \\\"\\ud83d\\udce5 <b>Import Massal CSV</b>\\\\n\\\\n\\\"\\n        \\\"Reply file CSV dengan kolom:\\\\n\\\"\\n        \\\"<code>email,password,recovery,proxy,imap_host,imap_port,note</code>\\\\n\\\\n\\\"\\n        \\\"Contoh baris:\\\\n\\\"\\n        \\\"<code>parent1@gmail.com,apppassword,recovery@outlook.com,socks5://user:pass@host:port,,,\\\\n\\\"\\n        \\\"parent2@gmail.com,apppassword,,,,,</code>\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=ReplyKeyboardRemove(),\\n    )\\n    return IMPORT_FILE\\n\\n\\n@auth_guard\\nasync def import_file(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    if not update.message.document:\\n        await update.message.reply_text(\\\"\\u274c Kirim file CSV (bukan teks).\\\")\\n        return IMPORT_FILE\\n\\n    doc = update.message.document\\n    if not doc.file_name.endswith(\\\".csv\\\"):\\n        await update.message.reply_text(\\\"\\u274c File harus .csv\\\")\\n        return IMPORT_FILE\\n\\n    # Download file\\n    file = await context.bot.get_file(doc.file_id)\\n    import tempfile\\n    with tempfile.NamedTemporaryFile(suffix=\\\".csv\\\", delete=False) as tmp:\\n        await file.download_to_drive(tmp.name)\\n        tmp_path = tmp.name\\n\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    import csv\\n\\n    added = skipped = errors = 0\\n    with open(tmp_path, newline=\\\"\\\", encoding=\\\"utf-8-sig\\\") as f:\\n        reader = csv.DictReader(f)\\n        for row in reader:\\n            email = (row.get(\\\"email\\\") or \\\"\\\").strip()\\n            if not email or \\\"@\\\" not in email:\\n                errors += 1\\n                continue\\n            pwd = (row.get(\\\"password\\\") or \\\"\\\").strip()\\n            if not pwd:\\n                errors += 1\\n                continue\\n            ok, _ = db.add(\\n                email=email,\\n                password=pwd,\\n                recovery=(row.get(\\\"recovery\\\") or \\\"\\\").strip(),\\n                proxy=(row.get(\\\"proxy\\\") or \\\"\\\").strip(),\\n                imap_host=(row.get(\\\"imap_host\\\") or \\\"\\\").strip(),\\n                imap_port=(row.get(\\\"imap_port\\\") or \\\"\\\").strip(),\\n                note=(row.get(\\\"note\\\") or \\\"\\\").strip(),\\n            )\\n            if ok:\\n                added += 1\\n            else:\\n                skipped += 1\\n\\n    Path(tmp_path).unlink(missing_ok=True)\\n    await update.message.reply_text(\\n        f\\\"\\u2705 <b>Import selesai</b>\\\\n\\\"\\n        f\\\"Ditambahkan: {added}\\\\n\\\"\\n        f\\\"Dilewati (duplikat): {skipped}\\\\n\\\"\\n        f\\\"Error format: {errors}\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=build_main_keyboard(),\\n    )\\n    return ConversationHandler.END\\n\\n\\n# ===================== COMMAND: /delete =====================\\n@auth_guard\\nasync def delete_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    args = context.args\\n    if not args:\\n        await update.message.reply_text(\\\"Usage: /delete <email>\\\")\\n        return\\n    email = args[0].strip()\\n    if not db.find(email):\\n        await update.message.reply_text(f\\\"\\u274c Akun {mask_email(email)} tidak ditemukan.\\\")\\n        return\\n    # Konfirmasi inline\\n    await update.message.reply_text(\\n        f\\\"\\u26a0\\ufe0f Hapus <code>{mask_email(email)}</code>?\\\\n\\\"\\n        \\\"Kirim <b>YA</b> untuk konfirmasi, <b>BATAL</b> untuk cancel.\\\",\\n        parse_mode=\\\"HTML\\\",\\n    )\\n    context.user_data[\\\"del_email\\\"] = email\\n    return DELETE_CONFIRM\\n\\n\\n@auth_guard\\nasync def delete_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    ans = update.message.text.strip().lower()\\n    email = context.user_data.get(\\\"del_email\\\")\\n    if ans in (\\\"ya\\\", \\\"y\\\", \\\"yes\\\") and email:\\n        db = context.bot_data[\\\"db\\\"]\\n        db.remove(email)\\n        await update.message.reply_text(f\\\"\\ud83d\\uddd1\\ufe0f <code>{mask_email(email)}</code> dihapus.\\\", parse_mode=\\\"HTML\\\", reply_markup=build_main_keyboard())\\n    else:\\n        await update.message.reply_text(\\\"\\u274c Dibatalkan.\\\", reply_markup=build_main_keyboard())\\n    context.user_data.clear()\\n    return ConversationHandler.END\\n\\n\\n# ===================== CONVERSATION: /set =====================\\nSET_FIELDS = [\\\"status\\\", \\\"paused\\\", \\\"note\\\", \\\"proxy\\\", \\\"password\\\"]\\n\\n@auth_guard\\nasync def set_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    db = context.bot_data[\\\"db\\\"]\\n    args = context.args\\n    if not args:\\n        await update.message.reply_text(\\n            \\\"Usage: /set <email>\\\\n\\\"\\n            \\\"Lalu pilih field: status / paused / note / proxy / password\\\"\\n        )\\n        return\\n    email = args[0].strip()\\n    acc = db.find(email)\\n    if not acc:\\n        await update.message.reply_text(f\\\"\\u274c Akun {mask_email(email)} tidak ditemukan.\\\")\\n        return\\n    context.user_data[\\\"set_email\\\"] = email\\n    keyboard = ReplyKeyboardMarkup(\\n        [[f] for f in SET_FIELDS] + [[\\\"BATAL\\\"]],\\n        resize_keyboard=True,\\n        one_time_keyboard=True,\\n    )\\n    await update.message.reply_text(\\n        f\\\"\\ud83d\\udd27 Ubah field untuk <code>{mask_email(email)}</code>:\\\\n\\\"\\n        f\\\"Status sekarang: {acc.get('status')} | Paused: {acc.get('paused')}\\\\n\\\"\\n        f\\\"Proxy: {acc.get('proxy') or '-'}\\\\n\\\"\\n        f\\\"Note: {acc.get('note') or '-'}\\\\n\\\\n\\\"\\n        \\\"Pilih field:\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=keyboard,\\n    )\\n    return SET_FIELD\\n\\n\\n@auth_guard\\nasync def set_field(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    field = update.message.text.strip().lower()\\n    if field == \\\"batal\\\":\\n        await update.message.reply_text(\\\"\\u274c Dibatalkan.\\\", reply_markup=build_main_keyboard())\\n        return ConversationHandler.END\\n    if field not in SET_FIELDS:\\n        await update.message.reply_text(\\\"\\u274c Field tidak valid. Pilih dari keyboard.\\\")\\n        return SET_FIELD\\n    context.user_data[\\\"set_field\\\"] = field\\n    if field == \\\"status\\\":\\n        await update.message.reply_text(\\n            \\\"Kirim status baru: <b>healthy</b> / <b>unhealthy</b> / <b>untested</b>\\\",\\n            parse_mode=\\\"HTML\\\",\\n            reply_markup=ReplyKeyboardRemove(),\\n        )\\n    elif field == \\\"paused\\\":\\n        await update.message.reply_text(\\n            \\\"Kirim: <b>true</b> (pause) atau <b>false</b> (aktifkan)\\\",\\n            parse_mode=\\\"HTML\\\",\\n            reply_markup=ReplyKeyboardRemove(),\\n        )\\n    elif field == \\\"proxy\\\":\\n        await update.message.reply_text(\\n            \\\"Kirim proxy baru (format: <code>socks5://user:pass@host:port</code>) atau '-' untuk hapus:\\\",\\n            parse_mode=\\\"HTML\\\",\\n            reply_markup=ReplyKeyboardRemove(),\\n        )\\n    elif field == \\\"password\\\":\\n        await update.message.reply_text(\\n            \\\"Kirim password/app password baru (akan dihapus otomatis):\\\",\\n            parse_mode=\\\"HTML\\\",\\n            reply_markup=ReplyKeyboardRemove(),\\n        )\\n    else:  # note\\n        await update.message.reply_text(\\n            \\\"Kirim catatan baru (atau '-' untuk hapus):\\\",\\n            parse_mode=\\\"HTML\\\",\\n            reply_markup=ReplyKeyboardRemove(),\\n        )\\n    return SET_VALUE\\n\\n\\n@auth_guard\\nasync def set_value(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    val = update.message.text.strip()\\n    field = context.user_data.get(\\\"set_field\\\")\\n    email = context.user_data.get(\\\"set_email\\\")\\n    db = context.bot_data[\\\"db\\\"]\\n\\n    # Hapus pesan kredensial\\n    if field in (\\\"password\\\", \\\"proxy\\\") and val != \\\"-\\\":\\n        await safe_delete_message(context, update.effective_chat.id, update.message.message_id)\\n\\n    updates = {}\\n    if field == \\\"status\\\":\\n        if val not in (\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\"):\\n            await update.message.reply_text(\\\"\\u274c Status harus: healthy / unhealthy / untested\\\")\\n            return SET_VALUE\\n        updates[\\\"status\\\"] = val\\n    elif field == \\\"paused\\\":\\n        updates[\\\"paused\\\"] = val.lower() in (\\\"true\\\", \\\"1\\\", \\\"yes\\\", \\\"ya\\\")\\n    elif field == \\\"note\\\":\\n        updates[\\\"note\\\"] = val if val != \\\"-\\\" else \\\"\\\"\\n    elif field == \\\"proxy\\\":\\n        updates[\\\"proxy\\\"] = val if val != \\\"-\\\" else \\\"\\\"\\n    elif field == \\\"password\\\":\\n        updates[\\\"password\\\"] = val\\n\\n    db.update(email, **updates)\\n    await update.message.reply_text(\\n        f\\\"\\u2705 <code>{mask_email(email)}</code> \\u2192 {field} diperbarui.\\\",\\n        parse_mode=\\\"HTML\\\",\\n        reply_markup=build_main_keyboard(),\\n    )\\n    context.user_data.clear()\\n    return ConversationHandler.END\\n\\n\\n# ===================== CANCEL HANDLER =====================\\nasync def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):\\n    await update.message.reply_text(\\\"\\u274c Dibatalkan.\\\", reply_markup=build_main_keyboard())\\n    context.user_data.clear()\\n    return ConversationHandler.END\\n\\n\\n# ===================== BACKGROUND MONITOR =====================\\nasync def run_monitor(context: ContextTypes.DEFAULT_TYPE):\\n    \\\"\\\"\\\"Background task: cek berkala (dijalankan di thread terpisah).\\\"\\\"\\\"\\n    cfg = context.bot_data[\\\"cfg\\\"]\\n    db = context.bot_data[\\\"db\\\"]\\n    notifier = context.bot_data[\\\"notifier\\\"]\\n    interval = cfg[\\\"check\\\"].get(\\\"interval_minutes\\\", 60)\\n    threshold = cfg[\\\"check\\\"].get(\\\"consecutive_fail_threshold\\\", 1)\\n\\n    log.info(\\\"Monitor started: interval=%d min\\\", interval)\\n    while True:\\n        await asyncio.sleep(60)  # cek tiap menit apakah ada yg jatuh tempo\\n        accounts = db.load()\\n        now = time.time()\\n        due = []\\n        for a in accounts:\\n            if a.get(\\\"paused\\\"):\\n                continue\\n            lc = a.get(\\\"last_check\\\") or \\\"\\\"\\n            try:\\n                last_ts = datetime.fromisoformat(lc).timestamp()\\n            except Exception:\\n                last_ts = 0\\n            if now - last_ts >= interval * 60:\\n                due.append(a)\\n        if due:\\n            log.info(\\\"Monitor: checking %d due accounts\\\", len(due))\\n            for acc in due:\\n                res = check_one(acc, cfg)\\n                acc[\\\"last_check\\\"] = now_iso()\\n                acc[\\\"last_result\\\"] = res\\n                if res[\\\"status\\\"] == \\\"ok\\\":\\n                    acc[\\\"fail_count\\\"] = 0\\n                    new_status = \\\"healthy\\\"\\n                else:\\n                    acc[\\\"fail_count\\\"] = acc.get(\\\"fail_count\\\", 0) + 1\\n                    new_status = \\\"unhealthy\\\" if acc[\\\"fail_count\\\"] >= threshold else acc.get(\\\"status\\\", \\\"untested\\\")\\n                old_status = acc.get(\\\"status\\\", \\\"untested\\\")\\n                acc[\\\"status\\\"] = new_status\\n                if new_status != old_status:\\n                    acc[\\\"last_changed\\\"] = now_iso()\\n                    notifier.alert_status(acc[\\\"email\\\"], old_status, new_status, res[\\\"detail\\\"], res[\\\"latency_ms\\\"])\\n            db.save(accounts)\\n\\n\\n# ===================== MAIN ENTRY =====================\\nimport asyncio\\n\\n\\nasync def run_bot(cfg, db, notifier):\\n    \\\"\\\"\\\"Jalankan bot Telegram + background monitor.\\\"\\\"\\\"\\n    token = os.environ.get(\\\"TG_BOT_TOKEN\\\") or cfg.get(\\\"telegram\\\", {}).get(\\\"bot_token\\\", \\\"\\\")\\n    if not token:\\n        log.warning(\\\"TG_BOT_TOKEN tidak diset \\u2014 bot Telegram tidak jalan\\\")\\n        return\\n\\n    application = Application.builder().token(token).build()\\n    application.bot_data[\\\"cfg\\\"] = cfg\\n    application.bot_data[\\\"db\\\"] = db\\n    application.bot_data[\\\"notifier\\\"] = notifier\\n\\n    # Conversation handlers\\n    add_conv = ConversationHandler(\\n        entry_points=[CommandHandler(\\\"add\\\", add_start)],\\n        states={\\n            ADD_EMAIL: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_email)],\\n            ADD_PASSWORD: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_password)],\\n            ADD_RECOVERY: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_recovery)],\\n            ADD_PROXY: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_proxy)],\\n            ADD_CONFIRM: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_confirm)],\\n        },\\n        fallbacks=[CommandHandler(\\\"cancel\\\", cancel)],\\n        per_user=True,\\n        per_chat=True,\\n    )\\n\\n    import_conv = ConversationHandler(\\n        entry_points=[CommandHandler(\\\"import\\\", import_start)],\\n        states={\\n            IMPORT_FILE: [MessageHandler(filters.Document.FileExtension(\\\"csv\\\"), import_file)],\\n        },\\n        fallbacks=[CommandHandler(\\\"cancel\\\", cancel)],\\n        per_user=True,\\n        per_chat=True,\\n    )\\n\\n    delete_conv = ConversationHandler(\\n        entry_points=[CommandHandler(\\\"delete\\\", delete_cmd)],\\n        states={\\n            DELETE_CONFIRM: [MessageHandler(filters.TEXT & ~filters.COMMAND, delete_confirm)],\\n        },\\n        fallbacks=[CommandHandler(\\\"cancel\\\", cancel)],\\n        per_user=True,\\n        per_chat=True,\\n    )\\n\\n    set_conv = ConversationHandler(\\n        entry_points=[CommandHandler(\\\"set\\\", set_cmd)],\\n        states={\\n            SET_FIELD: [MessageHandler(filters.TEXT & ~filters.COMMAND, set_field)],\\n            SET_VALUE: [MessageHandler(filters.TEXT & ~filters.COMMAND, set_value)],\\n        },\\n        fallbacks=[CommandHandler(\\\"cancel\\\", cancel)],\\n        per_user=True,\\n        per_chat=True,\\n    )\\n\\n    # Command handlers\\n    application.add_handler(CommandHandler(\\\"start\\\", cmd_start))\\n    application.add_handler(CommandHandler(\\\"help\\\", cmd_help))\\n    application.add_handler(CommandHandler(\\\"list\\\", cmd_list))\\n    application.add_handler(CommandHandler(\\\"check\\\", cmd_check))\\n    application.add_handler(CommandHandler(\\\"export\\\", cmd_export))\\n    application.add_handler(CommandHandler(\\\"stats\\\", cmd_stats))\\n    application.add_handler(CommandHandler(\\\"tgtest\\\", cmd_tgtest))\\n    application.add_handler(add_conv)\\n    application.add_handler(import_conv)\\n    application.add_handler(delete_conv)\\n    application.add_handler(set_conv)\\n\\n    # Start background monitor\\n    asyncio.create_task(run_monitor(application))\\n\\n    log.info(\\\"Bot Telegram started (polling)\\\")\\n    await application.run_polling(allowed_updates=Update.ALL_TYPES)\\n\\n\\ndef start_bot_thread(cfg, db, notifier):\\n    \\\"\\\"\\\"Jalankan bot di thread terpisah (non-blocking).\\\"\\\"\\\"\\n    def _run():\\n        asyncio.run(run_bot(cfg, db, notifier))\\n    t = threading.Thread(target=_run, daemon=True)\\n    t.start()\\n    return t\",\"path\":\"/home/runner/ptero-akun-parent-manager/manager/telegram_bot.py\"}"
