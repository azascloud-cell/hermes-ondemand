            {
              "id": "call-9a6e7019-bef0-48e0-8fec-0ccb48f40a0d",
              "type": "function",
              "function": {
                "name": "write_file",
                "arguments": "{\"content\":\"#!/usr/bin/env python3\\n# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"\\nPtero Akun Parent Manager \\u2014 bot Pterodactyl untuk mengelola & memantau\\nkesehatan akun parent (cek IMAP, monitor otomatis, export akun sehat,\\nnotifikasi Telegram).\\n\\nPerintah: add / list / check / auto / export / import / remove / set / stats / tg-test\\n\\\"\\\"\\\"\\nimport argparse\\nimport logging\\nimport os\\nimport sys\\nimport time\\nfrom collections import Counter\\nfrom datetime import datetime\\n\\nfrom manager.database import AccountDB\\nfrom manager.exporter import export_accounts\\nfrom manager.health import check_one, run_checks\\nfrom manager.notifier import Notifier\\nfrom manager.utils import load_config, mask_email, now_iso, print_table, status_icon\\n\\nAPP_DIR = os.path.dirname(os.path.abspath(__file__))\\nCONFIG_PATH = os.path.join(APP_DIR, \\\"config.json\\\")\\nDB_PATH = os.path.join(APP_DIR, \\\"accounts.json\\\")\\nLOG_DIR = os.path.join(APP_DIR, \\\"logs\\\")\\n\\nos.makedirs(LOG_DIR, exist_ok=True)\\nlogging.basicConfig(\\n    level=logging.INFO,\\n    format=\\\"%(asctime)s [%(levelname)s] %(message)s\\\",\\n    handlers=[\\n        logging.StreamHandler(sys.stdout),\\n        logging.FileHandler(os.path.join(LOG_DIR, \\\"app.log\\\"), encoding=\\\"utf-8\\\"),\\n    ],\\n)\\nlog = logging.getLogger(\\\"main\\\")\\n\\nBANNER = \\\"\\\"\\\"\\n\\\\033[1;36m\\n \\u2554\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2557\\n \\u2551      PTERO AKUN PARENT MANAGER  (bot monitor)    \\u2551\\n \\u255a\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u2550\\u255d\\\\033[0m\\\"\\\"\\\"\\n\\n\\ndef green(s): return f\\\"\\\\033[32m{s}\\\\033[0m\\\"\\ndef red(s): return f\\\"\\\\033[31m{s}\\\\033[0m\\\"\\ndef yellow(s): return f\\\"\\\\033[33m{s}\\\\033[0m\\\"\\ndef cyan(s): return f\\\"\\\\033[36m{s}\\\\033[0m\\\"\\ndef bold(s): return f\\\"\\\\033[1m{s}\\\\033[0m\\\"\\n\\n\\ndef to_ts(iso):\\n    try:\\n        return datetime.fromisoformat(iso).timestamp()\\n    except Exception:\\n        return 0\\n\\n\\ndef update_and_report(db, accounts, results, cfg, notifier):\\n    \\\"\\\"\\\"Terapkan hasil check ke DB, cetak laporan, kirim notif perubahan status.\\\"\\\"\\\"\\n    threshold = int(cfg[\\\"check\\\"].get(\\\"consecutive_fail_threshold\\\", 1))\\n    n_healthy = n_bad = 0\\n    changed = []\\n    for acc, res in zip(accounts, results):\\n        em = acc[\\\"email\\\"]\\n        succeed = res[\\\"status\\\"] == \\\"ok\\\"\\n        if succeed:\\n            acc[\\\"fail_count\\\"] = 0\\n            new_status = \\\"healthy\\\"\\n            n_healthy += 1\\n        else:\\n            acc[\\\"fail_count\\\"] = int(acc.get(\\\"fail_count\\\") or 0) + 1\\n            prev = acc.get(\\\"status\\\", \\\"untested\\\")\\n            new_status = \\\"unhealthy\\\" if acc[\\\"fail_count\\\"] >= threshold else prev\\n            n_bad += 1\\n        acc[\\\"last_check\\\"] = now_iso()\\n        acc[\\\"last_result\\\"] = {\\n            \\\"status\\\": res[\\\"status\\\"],\\n            \\\"detail\\\": res[\\\"detail\\\"],\\n            \\\"latency_ms\\\": res[\\\"latency_ms\\\"],\\n        }\\n        old = acc.get(\\\"status\\\", \\\"untested\\\")\\n        if new_status != old:\\n            changed.append((em, old, new_status, res[\\\"detail\\\"], res[\\\"latency_ms\\\"]))\\n            acc[\\\"status\\\"] = new_status\\n            acc[\\\"last_changed\\\"] = now_iso()\\n        print(f\\\"{status_icon(new_status)} {em} \\u2014 {res['detail']} ({res['latency_ms']} ms)\\\")\\n    db.save(accounts)\\n    total = len(accounts)\\n    line = f\\\"Ringkasan: {green(str(n_healthy))} sehat, {red(str(n_bad))} bermasalah dari {total} akun\\\"\\n    print(bold(line))\\n    log.info(\\\"Ringkasan check: %d sehat, %d bermasalah, %d total\\\", n_healthy, n_bad, total)\\n    for em, old, new, reason, lat in changed:\\n        notifier.alert_status(em, old, new, reason, lat)\\n\\n\\ndef cmd_add(cfg, db, args):\\n    if \\\"@\\\" not in args.email:\\n        print(red(\\\"\\u2716 Email tidak valid.\\\"))\\n        return 1\\n    if not args.password:\\n        print(red(\\\"\\u2716 Password / app password wajib diisi (--password).\\\"))\\n        return 1\\n    ok, acc = db.add(\\n        email=args.email, password=args.password, recovery=args.recovery,\\n        proxy=args.proxy, imap_host=args.imap_host, imap_port=args.imap_port,\\n        note=args.note,\\n    )\\n    if not ok:\\n        print(yellow(f\\\"\\u26a0  {mask_email(acc['email'])} sudah ada di database (status: {acc.get('status')}).\\\"))\\n        return 0\\n    print(green(f\\\"\\u2705 Ditambahkan: {acc['email']} (status: untested)\\\"))\\n    if args.check:\\n        res = check_one(acc, cfg)\\n        update_and_report(db, [acc], [res], cfg, Notifier(cfg))\\n    return 0\\n\\n\\ndef cmd_list(cfg, db, args):\\n    accounts = db.load()\\n    if args.status and args.status != \\\"all\\\":\\n        accounts = [a for a in accounts if str(a.get(\\\"status\\\", \\\"untested\\\")).lower() == args.status.lower()]\\n    if args.limit:\\n        accounts = accounts[: args.limit]\\n    if not accounts:\\n        print(yellow(\\\"Database kosong atau tidak ada yang cocok. Tambah: python3 main.py add --help\\\"))\\n        return 0\\n    rows = []\\n    for i, a in enumerate(accounts, 1):\\n        rows.append([\\n            str(i),\\n            a.get(\\\"email\\\", \\\"-\\\"),\\n            status_icon(a.get(\\\"status\\\", \\\"untested\\\")) + \\\" \\\" + str(a.get(\\\"status\\\", \\\"untested\\\")),\\n            str(a.get(\\\"fail_count\\\", 0)),\\n            a.get(\\\"recovery\\\") or \\\"-\\\",\\n            \\\"\\u270b\\\" if a.get(\\\"paused\\\") else \\\"\\\",\\n            a.get(\\\"last_check\\\") or \\\"-\\\",\\n        ])\\n    print_table([\\\"#\\\", \\\"Email\\\", \\\"Status\\\", \\\"Gagal\\\", \\\"Recovery\\\", \\\"P\\\", \\\"Terakhir dicek\\\"], rows)\\n    print(f\\\"Total: {len(accounts)}\\\")\\n    return 0\\n\\n\\ndef cmd_check(cfg, db, args):\\n    accounts = db.load()\\n    if not accounts:\\n        print(yellow(\\\"Database kosong. Tambah dulu: python3 main.py add --email ... --password ...\\\"))\\n        return 0\\n    print(cyan(f\\\"\\ud83d\\udd0d Memeriksa kesehatan {len(accounts)} akun via IMAP (concurrency: {cfg['check'].get('concurrency', 3)})...\\\"))\\n    results = run_checks(accounts, cfg)\\n    update_and_report(db, accounts, results, cfg, Notifier(cfg))\\n    return 0\\n\\n\\ndef cmd_auto(cfg, db, args):\\n    interval = int(args.interval or cfg[\\\"check\\\"].get(\\\"interval_minutes\\\", 60))\\n    notifier = Notifier(cfg)\\n    print(BANNER)\\n    print(cyan(f\\\"\\ud83d\\udd50 Interval cek: {interval} menit | Log: logs/app.log | Telegram: {'ON' if notifier.enabled else 'OFF'}\\\"))\\n    print(yellow(\\\"Tekan Ctrl+C untuk berhenti.\\\\n\\\"))\\n    try:\\n        while True:\\n            accounts = db.load()\\n            now = time.time()\\n            due = []\\n            for a in accounts:\\n                if a.get(\\\"paused\\\"):\\n                    continue\\n                lc = a.get(\\\"last_check\\\") or \\\"\\\"\\n                age = (now - to_ts(lc)) if lc else (interval * 60 + 1)\\n                if age >= interval * 60:\\n                    due.append(a)\\n            if due:\\n                tick = f\\\"[{now_iso()}] Mengecek {len(due)} akun jatuh tempo...\\\"\\n                print(cyan(tick))\\n                log.info(tick)\\n                results = run_checks(due, cfg)\\n                update_and_report(db, due, results, cfg, notifier)\\n            else:\\n                print(f\\\"[{now_iso()}] Tidak ada akun jatuh tempo. Tidur 60 detik...\\\")\\n            time.sleep(60)\\n    except KeyboardInterrupt:\\n        print(\\\"\\\\n\\ud83d\\udc4b Bot dihentikan. Sampai jumpa!\\\")\\n    return 0\\n\\n\\ndef cmd_export(cfg, db, args):\\n    accounts = db.load()\\n    statuses = None\\n    if args.status and args.status.lower() != \\\"all\\\":\\n        statuses = [args.status.lower()]\\n    fmts = [\\\"csv\\\", \\\"json\\\"] if args.format == \\\"both\\\" else [args.format]\\n    for fmt in fmts:\\n        out = args.out or os.path.join(APP_DIR, f\\\"akun_{args.status or 'all'}.{fmt}\\\")\\n        n = export_accounts(accounts, out, fmt, statuses)\\n        print(green(f\\\"\\u2705 {n} akun status '{args.status}' diexport ke {out}\\\"))\\n    return 0\\n\\n\\ndef cmd_import(cfg, db, args):\\n    import csv as _csv\\n\\n    path = args.file\\n    if not os.path.exists(path):\\n        print(red(f\\\"\\u2716 File tidak ditemukan: {path}\\\"))\\n        return 1\\n    added = skipped = 0\\n    with open(path, newline=\\\"\\\", encoding=\\\"utf-8-sig\\\") as f:\\n        for row in _csv.DictReader(f):\\n            email = (row.get(\\\"email\\\") or \\\"\\\").strip()\\n            if not email or \\\"@\\\" not in email:\\n                continue\\n            ok, _ = db.add(\\n                email=email,\\n                password=(row.get(\\\"password\\\") or \\\"\\\").strip(),\\n                recovery=(row.get(\\\"recovery\\\") or \\\"\\\").strip(),\\n                proxy=(row.get(\\\"proxy\\\") or \\\"\\\").strip(),\\n                imap_host=(row.get(\\\"imap_host\\\") or \\\"\\\").strip(),\\n                imap_port=(row.get(\\\"imap_port\\\") or \\\"\\\").strip(),\\n                note=(row.get(\\\"note\\\") or \\\"\\\").strip(),\\n            )\\n            if ok:\\n                added += 1\\n            else:\\n                skipped += 1\\n    print(green(f\\\"\\u2705 Import selesai: {added} ditambahkan, {skipped} dilewati (duplikat).\\\"))\\n    return 0\\n\\n\\ndef cmd_remove(cfg, db, args):\\n    if not db.find(args.email):\\n        print(yellow(\\\"Akun tidak ditemukan.\\\"))\\n        return 1\\n    if not args.yes:\\n        ans = input(f\\\"Hapus {args.email}? (y/N): \\\").strip().lower()\\n        if ans != \\\"y\\\":\\n            print(\\\"Dibatalkan.\\\")\\n            return 0\\n    db.remove(args.email)\\n    print(green(f\\\"\\ud83d\\uddd1  {args.email} dihapus.\\\"))\\n    return 0\\n\\n\\ndef cmd_set(cfg, db, args):\\n    if not db.find(args.email):\\n        print(yellow(\\\"Akun tidak ditemukan.\\\"))\\n        return 1\\n    updates = {}\\n    if args.status:\\n        st = args.status.lower()\\n        if st not in (\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\"):\\n            print(red(\\\"Status harus: healthy / unhealthy / untested\\\"))\\n            return 1\\n        updates[\\\"status\\\"] = st\\n    if args.paused is not None:\\n        updates[\\\"paused\\\"] = args.paused.lower() in (\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"ya\\\")\\n    if args.note is not None:\\n        updates[\\\"note\\\"] = args.note\\n    if args.password:\\n        updates[\\\"password\\\"] = args.password\\n    if not updates:\\n        print(yellow(\\\"Tidak ada perubahan yang diminta.\\\"))\\n        return 0\\n    db.update(args.email, **updates)\\n    print(green(f\\\"\\u2705 {args.email} diperbarui: {updates}\\\"))\\n    return 0\\n\\n\\ndef cmd_stats(cfg, db, args):\\n    accounts = db.load()\\n    c = Counter(str(a.get(\\\"status\\\", \\\"untested\\\")) for a in accounts)\\n    total = len(accounts)\\n    paused = sum(1 for a in accounts if a.get(\\\"paused\\\"))\\n    last = max((a.get(\\\"last_check\\\") or \\\"\\\" for a in accounts), default=\\\"-\\\")\\n    print(bold(f\\\"\\ud83d\\udcca Total akun: {total}\\\"))\\n    for st in (\\\"healthy\\\", \\\"unhealthy\\\", \\\"untested\\\"):\\n        print(f\\\"  {status_icon(st)} {st}: {c.get(st, 0)}\\\")\\n    print(f\\\"  \\u270b paused: {paused}\\\")\\n    print(f\\\"  \\ud83d\\udd52 check terakhir: {last}\\\")\\n    if c.get(\\\"healthy\\\"):\\n        print(bold(f\\\"Persentase sehat: {100.0 * c['healthy'] / total:.1f}%\\\"))\\n    return 0\\n\\n\\ndef cmd_tgtest(cfg, db, args):\\n    n = Notifier(cfg)\\n    if not n.enabled:\\n        print(yellow(\\\"Telegram belum dikonfigurasi. Isi config.json \\u2192 telegram, atau env TG_BOT_TOKEN / TG_CHAT_ID. Lihat README.\\\"))\\n        return 1\\n    ok = n.send(\\\"\\u2705 Test notifikasi dari <b>Ptero Akun Parent Manager</b>\\\")\\n    print(green(\\\"Terikirim \\u2705\\\") if ok else red(\\\"Gagal kirim \\u2716 \\u2014 cek token/chat id dan log.\\\"))\\n    return 0 if ok else 1\\n\\n\\ndef build_parser():\\n    p = argparse.ArgumentParser(prog=\\\"main.py\\\", description=\\\"\\ud83c\\udfaf Bot Pterodactyl manajemen akun parent (cek kesehatan, auto-monitor, export akun sehat)\\\")\\n    sub = p.add_subparsers(dest=\\\"cmd\\\", metavar=\\\"perintah\\\")\\n\\n    a = sub.add_parser(\\\"add\\\", help=\\\"Tambah akun parent\\\")\\n    a.add_argument(\\\"--email\\\", required=True)\\n    a.add_argument(\\\"--password\\\", required=True, help=\\\"Password atau app password (Gmail wajib app password)\\\")\\n    a.add_argument(\\\"--recovery\\\", help=\\\"Email recovery (outlook/proton/dll)\\\")\\n    a.add_argument(\\\"--proxy\\\", help=\\\"Proxy opsional, format: socks5://user:pass@host:port\\\")\\n    a.add_argument(\\\"--imap-host\\\", help=\\\"Host IMAP kustom (default: imap.gmail.com)\\\")\\n    a.add_argument(\\\"--imap-port\\\", help=\\\"Port IMAP (default: 993)\\\")\\n    a.add_argument(\\\"--note\\\", help=\\\"Catatan (mis. nomor urut anak, d