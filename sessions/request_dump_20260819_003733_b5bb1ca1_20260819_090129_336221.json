 len(str(r[i] if i < len(r) else \\\"\\\")))\\n\\n    def fmt_row(cells):\\n        return \\\" | \\\".join(str(c).ljust(widths[i]) for i, c in enumerate(cells))\\n\\n    print(fmt_row(headers))\\n    print(\\\"-+-\\\".join(\\\"-\\\" * w for w in widths))\\n    for r in rows:\\n        print(fmt_row(r))\",\"path\":\"/home/runner/ptero-akun-parent-manager/manager/utils.py\"}"
