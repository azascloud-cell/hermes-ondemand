\\\\"password\\\\\\\": password}\\\\n\\\\n\\\\nclass SocksIMAP4SSL(imaplib.IMAP4_SSL):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"IMAP4_SSL yang koneksinya lewat proxy SOCKS5 (butuh Python >= 3.9).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, host, port, proxy, timeout=30):\\\\n        self._proxy = proxy or {}\\\\n        super().__init__(host, port, timeout=timeout)\\\\n\\\\n    def _create_socket(self, timeout):\\\\n        if timeout is not None and not timeout:\\\\n            raise ValueError(\\\\\\\"timeout=0 tidak didukung\\\\\\\")\\\\n        if self._proxy:\\\\n            import socks  # PySocks\\\\n\\\\n            s = socks.socksocket()\\\\n            s.set_proxy(\\\\n                socks.SOCKS5,\\\\n                self._proxy[\\\\\\\"host\\\\\\\"],\\\\n                self._proxy[\\\\\\\"port\\\\\\\"],\\\\n                username=self._proxy.get(\\\\\\\"user\\\\\\\"),\\\\n                password=self._proxy.get(\\\\\\\"password\\\\\\\"),\\\\n            )\\\\n            s.settimeout(timeout)\\\\n            log.debug(\\\\\\\"Koneksi IMAP via proxy %s:%s\\\\\\\", self._proxy[\\\\\\\"host\\\\\\\"], self._proxy[\\\\\\\"port\\\\\\\"])\\\\n            return s\\\\n        return socket.create_connection((self.host, self.port), timeout)\\\\n\\\\n\\\\ndef _elapsed(t0):\\\\n    return int((time.monotonic() - t0) * 1000)\\\\n\\\\n\\\\ndef check_one(acc, cfg):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Cek satu akun. Return: {status, detail, latency_ms}\\\\n    status: ok | auth_failed | timeout | conn_error | error\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    host = (acc.get(\\\\\\\"imap_host\\\\\\\") or \\\\\\\"\\\\\\\").strip() or cfg[\\\\\\\"imap\\\\\\\"][\\\\\\\"host\\\\\\\"]\\\\n    port = int((acc.get(\\\\\\\"imap_port\\\\\\\") or \\\\\\\"\\\\\\\").strip() or cfg[\\\\\\\"imap\\\\\\\"][\\\\\\\"port\\\\\\\"])\\\\n    timeout = int(cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"timeout_seconds\\\\\\\", 30))\\\\n    proxy = None\\\\n    if cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"use_proxy\\\\\\\") and acc.get(\\\\\\\"proxy\\\\\\\"):\\\\n        proxy = parse_proxy(acc[\\\\\\\"proxy\\\\\\\"])\\\\n\\\\n    t0 = time.monotonic()\\\\n    conn = None\\\\n    try:\\\\n        if proxy:\\\\n            conn = SocksIMAP4SSL(host, port, proxy, timeout=timeout)\\\\n        else:\\\\n            conn = imaplib.IMAP4_SSL(host, port, timeout=timeout)\\\\n        conn.login(acc[\\\\\\\"email\\\\\\\"], acc[\\\\\\\"password\\\\\\\"])\\\\n        try:\\\\n            conn.logout()\\\\n        except Exception:\\\\n            pass\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"ok\\\\\\\", \\\\\\\"detail\\\\\\\": \\\\\\\"login berhasil\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except imaplib.IMAP4.error as e:\\\\n        msg = str(e).replace(\\\\\\\"\\\\\\\\r\\\\\\\", \\\\\\\" \\\\\\\").replace(\\\\\\\"\\\\\\\\n\\\\\\\", \\\\\\\" \\\\\\\")[:140]\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"auth_failed\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"login ditolak: {msg}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except socket.timeout:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"timeout\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"timeout {timeout}s\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except (ssl.SSLError, OSError, ConnectionError) as e:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"conn_error\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"{type(e).__name__}: {str(e)[:100]}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except Exception as e:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"error\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"{type(e).__name__}: {str(e)[:100]}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    finally:\\\\n        if conn:\\\\n            try:\\\\n                conn.shutdown()\\\\n            except Exception:\\\\n                pass\\\\n\\\\n\\\\ndef run_checks(accounts, cfg):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Cek semua akun (paralel). Hasil mengikuti urutan input.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    concurrency = int(cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"concurrency\\\\\\\", 3))\\\\n    results = [None] * len(accounts)\\\\n    if concurrency <= 1 or len(accounts) <= 1:\\\\n        return [check_one(a, cfg) for a in accounts]\\\\n    with ThreadPoolExecutor(max_workers=concurrency) as pool:\\\\n        futs = {pool.submit(check_one, acc, cfg): i for i, acc in enumerate(accounts)}\\\\n        for fut in as_completed(futs):\\\\n            results[futs[fut]] = fut.result()\\\\n    return results\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/health.py\\\"}\"}}, {\"id\": \"call_3994e04b6b714031bad6813c\", \"call_id\": \"call_3994e04b6b714031bad6813c\", \"response_item_id\": \"fc_3994e04b6b714031bad6813c\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Notifikasi Telegram (opsional). Token/chat id dari config.json atau env\\\\nTG_BOT_TOKEN / TG_CHAT_ID (variabel egg Pterodactyl).\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport logging\\\\nimport os\\\\n\\\\nimport requests\\\\n\\\\nlog = logging.getLogger(\\\\\\\"notify\\\\\\\")\\\\n\\\\n\\\\nclass Notifier:\\\\n    def __init__(self, cfg):\\\\n        tg = cfg.get(\\\\\\\"telegram\\\\\\\", {})\\\\n        self.token = os.environ.get(\\\\\\\"TG_BOT_TOKEN\\\\\\\") or tg.get(\\\\\\\"bot_token\\\\\\\") or \\\\\\\"\\\\\\\"\\\\n        self.chat_id = os.environ.get(\\\\\\\"TG_CHAT_ID\\\\\\\") or str(tg.get(\\\\\\\"chat_id\\\\\\\") or \\\\\\\"\\\\\\\")\\\\n        self.enabled = bool(self.token and self.chat_id)\\\\n\\\\n    def send(self, text):\\\\n        if not self.enabled:\\\\n            return False\\\\n        try:\\\\n            r = requests.post(\\\\n                f\\\\\\\"https://api.telegram.org/bot{self.token}/sendMessage\\\\\\\",\\\\n                json={\\\\n                    \\\\\\\"chat_id\\\\\\\": self.chat_id,\\\\n                    \\\\\\\"text\\\\\\\": text,\\\\n                    \\\\\\\"parse_mode\\\\\\\": \\\\\\\"HTML\\\\\\\",\\\\n                    \\\\\\\"disable_web_page_preview\\\\\\\": True,\\\\n                },\\\\n                timeout=15,\\\\n            )\\\\n            ok = r.status_code == 200 and r.json().get(\\\\\\\"ok\\\\\\\")\\\\n            if not ok:\\\\n                log.warning(\\\\\\\"Telegram API: %s\\\\\\\", r.text[:200])\\\\n            return ok\\\\n        except Exception as e:\\\\n            log.warning(\\\\\\\"Gagal kirim Telegram: %s\\\\\\\", e)\\\\n            return False\\\\n\\\\n    @staticmethod\\\\n    def _esc(text):\\\\n        return str(text).replace(\\\\\\\"&\\\\\\\", \\\\\\\"&amp;\\\\\\\").replace(\\\\\\\"<\\\\\\\", \\\\\\\"&lt;\\\\\\\").replace(\\\\\\\">\\\\\\\", \\\\\\\"&gt;\\\\\\\")\\\\n\\\\n    def alert_status(self, email, old, new, reason, latency):\\\\n        if not self.enabled:\\\\n            return\\\\n        icon = \\\\\\\"✅\\\\\\\" if new == \\\\\\\"healthy\\\\\\\" else \\\\\\\"⚠️\\\\\\\"\\\\n        self.send(\\\\n            f\\\\\\\"{icon} <b>Status akun parent berubah</b>\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"📧 {self._esc(email)}\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Status: {self._esc(old)} → <b>{self._esc(new)}</b>\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Alasan: {self._esc(reason)}\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Latensi: {latency} ms\\\\\\\"\\\\n        )\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/notifier.py\\\"}\"}}, {\"id\": \"call_2cb4946181a4411c98b1c3ac\", \"call_id\": \"call_2cb4946181a4411c98b1c3ac\", \"response_item_id\": \"fc_2cb4946181a4411c98b1c3ac\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Export daftar akun (mis. yang masih sehat) ke CSV/JSON.\\\\n\\\\nCATATAN: file export berisi password — perlakukan seperti file rahasia\\\\n(chmod 600