countDB\\\\nfrom manager.exporter import export_accounts\\\\nfrom manager.health import check_one, run_checks\\\\nfrom manager.notifier import Notifier\\\\nfrom manager.utils import load_config, mask_email, now_iso, print_table, status_icon\\\\n\\\\nAPP_DIR = os.path.dirname(os.path.abspath(__file__))\\\\nCONFIG_PATH = os.path.join(APP_DIR, \\\\\\\"config.json\\\\\\\")\\\\nDB_PATH = os.path.join(APP_DIR, \\\\\\\"accounts.json\\\\\\\")\\\\nLOG_DIR = os.path.join(APP_DIR, \\\\\\\"logs\\\\\\\")\\\\n\\\\nos.makedirs(LOG_DIR, exist_ok=True)\\\\nlogging.basicConfig(\\\\n    level=logging.INFO,\\\\n    format=\\\\\\\"%(asctime)s [%(levelname)s] %(message)s\\\\\\\",\\\\n    handlers=[\\\\n        logging.StreamHandler(sys.stdout),\\\\n        logging.FileHandler(os.path.join(LOG_DIR, \\\\\\\"app.log\\\\\\\"), encoding=\\\\\\\"utf-8\\\\\\\"),\\\\n    ],\\\\n)\\\\nlog = logging.getLogger(\\\\\\\"main\\\\\\\")\\\\n\\\\nBANNER = \\\\\\\"\\\\\\\"\\\\\\\"\\\\\\\\033[1;36m\\\\n ╔══════════════════════════════════════════════════╗\\\\n ║      PTERO AKUN PARENT MANAGER  (bot monitor)    ║\\\\n ╚══════════════════════════════════════════════════╝\\\\\\\\033[0m\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n\\\\ndef green(s): return f\\\\\\\"\\\\\\\\033[32m{s}\\\\\\\\033[0m\\\\\\\"\\\\ndef red(s): return f\\\\\\\"\\\\\\\\033[31m{s}\\\\\\\\033[0m\\\\\\\"\\\\ndef yellow(s): return f\\\\\\\"\\\\\\\\033[33m{s}\\\\\\\\033[0m\\\\\\\"\\\\ndef cyan(s): return f\\\\\\\"\\\\\\\\033[36m{s}\\\\\\\\033[0m\\\\\\\"\\\\ndef bold(s): return f\\\\\\\"\\\\\\\\033[1m{s}\\\\\\\\033[0m\\\\\\\"\\\\n\\\\n\\\\ndef to_ts(iso):\\\\n    try:\\\\n        return datetime.fromisoformat(iso).timestamp()\\\\n    except Exception:\\\\n        return 0\\\\n\\\\n\\\\ndef update_and_report(db, accounts, results, cfg, notifier):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Terapkan hasil check ke DB, cetak laporan, kirim notif perubahan status.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    threshold = int(cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"consecutive_fail_threshold\\\\\\\", 1))\\\\n    n_healthy = n_bad = 0\\\\n    changed = []\\\\n    for acc, res in zip(accounts, results):\\\\n        em = acc[\\\\\\\"email\\\\\\\"]\\\\n        succeed = res[\\\\\\\"status\\\\\\\"] == \\\\\\\"ok\\\\\\\"\\\\n        if succeed:\\\\n            acc[\\\\\\\"fail_count\\\\\\\"] = 0\\\\n            new_status = \\\\\\\"healthy\\\\\\\"\\\\n            n_healthy += 1\\\\n        else:\\\\n            acc[\\\\\\\"fail_count\\\\\\\"] = int(acc.get(\\\\\\\"fail_count\\\\\\\") or 0) + 1\\\\n            prev = acc.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")\\\\n            new_status = \\\\\\\"unhealthy\\\\\\\" if acc[\\\\\\\"fail_count\\\\\\\"] >= threshold else prev\\\\n            n_bad += 1\\\\n        acc[\\\\\\\"last_check\\\\\\\"] = now_iso()\\\\n        acc[\\\\\\\"last_result\\\\\\\"] = {\\\\n            \\\\\\\"status\\\\\\\": res[\\\\\\\"status\\\\\\\"],\\\\n            \\\\\\\"detail\\\\\\\": res[\\\\\\\"detail\\\\\\\"],\\\\n            \\\\\\\"latency_ms\\\\\\\": res[\\\\\\\"latency_ms\\\\\\\"],\\\\n        }\\\\n        old = acc.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")\\\\n        if new_status != old:\\\\n            changed.append((em, old, new_status, res[\\\\\\\"detail\\\\\\\"], res[\\\\\\\"latency_ms\\\\\\\"]))\\\\n            acc[\\\\\\\"status\\\\\\\"] = new_status\\\\n            acc[\\\\\\\"last_changed\\\\\\\"] = now_iso()\\\\n        print(f\\\\\\\"{status_icon(new_status)} {em} — {res['detail']} ({res['latency_ms']} ms)\\\\\\\")\\\\n    db.save(accounts)\\\\n    total = len(accounts)\\\\n    line = f\\\\\\\"Ringkasan: {green(str(n_healthy))} sehat, {red(str(n_bad))} bermasalah dari {total} akun\\\\\\\"\\\\n    print(bold(line))\\\\n    log.info(\\\\\\\"Ringkasan check: %d sehat, %d bermasalah, %d total\\\\\\\", n_healthy, n_bad, total)\\\\n    for em, old, new, reason, lat in changed:\\\\n        notifier.alert_status(em, old, new, reason, lat)\\\\n\\\\n\\\\ndef cmd_add(cfg, db, args):\\\\n    if \\\\\\\"@\\\\\\\" not in args.email:\\\\n        print(red(\\\\\\\"✖ Email tidak valid.\\\\\\\"))\\\\n        return 1\\\\n    if not args.password:\\\\n        print(red(\\\\\\\"✖ Password / app password wajib diisi (--password).\\\\\\\"))\\\\n        return 1\\\\n    ok, acc = db.add(\\\\n        email=args.email, password=args.password, recovery=args.recovery,\\\\n        proxy=args.proxy, imap_host=args.imap_host, imap_port=args.imap_port,\\\\n        note=args.note,\\\\n    )\\\\n    if not ok:\\\\n        print(yellow(f\\\\\\\"⚠  {mask_email(acc['email'])} sudah ada di database (status: {acc.get('status')}).\\\\\\\"))\\\\n        return 0\\\\n    print(green(f\\\\\\\"✅ Ditambahkan: {acc['email']} (status: untested)\\\\\\\"))\\\\n    if args.check:\\\\n        res = check_one(acc, cfg)\\\\n        update_and_report(db, [acc], [res], cfg, Notifier(cfg))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_list(cfg, db, args):\\\\n    accounts = db.load()\\\\n    if args.status and args.status != \\\\\\\"all\\\\\\\":\\\\n        accounts = [a for a in accounts if str(a.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")).lower() == args.status.lower()]\\\\n    if args.limit:\\\\n        accounts = accounts[: args.limit]\\\\n    if not accounts:\\\\n        print(yellow(\\\\\\\"Database kosong atau tidak ada yang cocok. Tambah: python3 main.py add --help\\\\\\\"))\\\\n        return 0\\\\n    rows = []\\\\n    for i, a in enumerate(accounts, 1):\\\\n        rows.append([\\\\n            str(i),\\\\n            a.get(\\\\\\\"email\\\\\\\", \\\\\\\"-\\\\\\\"),\\\\n            status_icon(a.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")) + \\\\\\\" \\\\\\\" + str(a.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")),\\\\n            str(a.get(\\\\\\\"fail_count\\\\\\\", 0)),\\\\n            a.get(\\\\\\\"recovery\\\\\\\") or \\\\\\\"-\\\\\\\",\\\\n            \\\\\\\"✋\\\\\\\" if a.get(\\\\\\\"paused\\\\\\\") else \\\\\\\"\\\\\\\",\\\\n            a.get(\\\\\\\"last_check\\\\\\\") or \\\\\\\"-\\\\\\\",\\\\n        ])\\\\n    print_table([\\\\\\\"#\\\\\\\", \\\\\\\"Email\\\\\\\", \\\\\\\"Status\\\\\\\", \\\\\\\"Gagal\\\\\\\", \\\\\\\"Recovery\\\\\\\", \\\\\\\"P\\\\\\\", \\\\\\\"Terakhir dicek\\\\\\\"], rows)\\\\n    print(f\\\\\\\"Total: {len(accounts)}\\\\\\\")\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_check(cfg, db, args):\\\\n    accounts = db.load()\\\\n    if not accounts:\\\\n        print(yellow(\\\\\\\"Database kosong. Tambah dulu: python3 main.py add --email ... --password ...\\\\\\\"))\\\\n        return 0\\\\n    print(cyan(f\\\\\\\"🔍 Memeriksa kesehatan {len(accounts)} akun via IMAP (concurrency: {cfg['check'].get('concurrency', 3)})...\\\\\\\"))\\\\n    results = run_checks(accounts, cfg)\\\\n    update_and_report(db, accounts, results, cfg, Notifier(cfg))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_auto(cfg, db, args):\\\\n    interval = int(args.interval or cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"interval_minutes\\\\\\\", 60))\\\\n    notifier = Notifier(cfg)\\\\n    print(BANNER)\\\\n    print(cyan(f\\\\\\\"🕐 Interval cek: {interval} menit | Log: logs/app.log | Telegram: {'ON' if notifier.enabled else 'OFF'}\\\\\\\"))\\\\n    print(yellow(\\\\\\\"Tekan Ctrl+C untuk berhenti.\\\\\\\\n\\\\\\\"))\\\\n    try:\\\\n        while True:\\\\n            accounts = db.load()\\\\n            now = time.time()\\\\n            due = []\\\\n            for a in accounts:\\\\n                if a.get(\\\\\\\"paused\\\\\\\"):\\\\n                    continue\\\\n                lc = a.get(\\\\\\\"last_check\\\\\\\") or \\\\\\\"\\\\\\\"\\\\n                age = (now - to_ts(lc)) if lc else (interval * 60 + 1)\\\\n                if age >= interval * 60:\\\\n                    due.append(a)\\\\n            if due:\\\\n                tick = f\\\\\\\"[{now_iso()}] Mengecek {len(due)} akun jatuh tempo...\\\\\\\"\\\\n                print(cyan(tick))\\\\n                log.info(tick)\\\\n                results = run_checks(due, cfg)\\\\n                update_and_report(db, due, results, cfg, notifier)\\\\n            else:\\\\n                print(f\\\\\\\"[{now_iso()}] Tidak ada akun jatuh tempo. Tidur 60 detik...\\\\\\\")\\\\n            time.sleep(60)\\\\n    except KeyboardInterrupt:\\\\n        print(\\\\\\\"\\\\\\\\n👋 Bot dihentikan. Sampai jumpa!\\\\\\\")\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_export(cfg, db, args):\\\\n    accounts = db.load()\\\\n    statuses = None\\\\n    if args.status and args.status.lower() != \\\\\\\"all\\\\\\\":\\\\n        statuses = [args.status.lower()]\\\\n    fmts = [\\\\\\\"csv\\\\\\\", \\\\\\\"json\\\\\\\"] if args.format == \\\\\\\"both\\\\\\\" else [args.format]\\\\n    for fmt in fmts:\\\\n        out = args.out or os.path.join(APP_DIR, f\\\\\\\"akun_{args.status or 'all'}.{fmt}\\\\\\\")\\\\n        n = export_accounts(accounts, out, fmt, statuses)\\\\n        print(green(f\\\\\\\"✅ {n} akun status '{args.status}' diexport ke {out}\\\\\\\"))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_import(cfg, db, args):\\\\n    import csv as _csv\\\\n\\\\n    path = args.file\\\\n    if not os.path.exists(path):\\\\n        print(red(f\\\\\\\"✖ File tidak ditemukan: {path}\\\\\\\"))\\\\n        return 1\\\\n    added = skipped = 0\\\\n    with open(path, newline=\\\\\\\"\\\\\\\", encoding=\\\\\\\"utf-8-sig\\\\\\\") as f:\\\\n        for row in _csv.DictReader(f):\\\\n            email = (row.get(\\\\\\\"email\\\\\\\") or \\\\\\\"\\\\\\\").strip()\\\\n            if not email or \\\\\\\"@\\\\\\\" not in email:\\\\n                continue\\\\n            ok, _ = db.add(\\\\n                email=email,\\\\n                password=(row.get(\\\\\\\"password\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n                recovery=(row.get(\\\\\\\"recovery\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n                proxy=(row.get(\\\\\\\"proxy\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n                imap_host=(row.get(\\\\\\\"imap_host\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n                imap_port=(row.get(\\\\\\\"imap_port\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n                note=(row.get(\\\\\\\"note\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n            )\\\\n            if ok:\\\\n                added += 1\\\\n            else:\\\\n                skipped += 1\\\\n    print(green(f\\\\\\\"✅ Import selesai: {added} ditambahkan, {skipped} dilewati (duplikat).\\\\\\\"))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_remove(cfg, db, args):\\\\n    if not db.find(args.email):\\\\n        print(yellow(\\\\\\\"Akun tidak ditemukan.\\\\\\\"))\\\\n        return 1\\\\n    if not args.yes:\\\\n        ans = input(f\\\\\\\"Hapus {args.email}? (y/N): \\\\\\\").strip().lower()\\\\n        if ans != \\\\\\\"y\\\\\\\":\\\\n            print(\\\\\\\"Dibatalkan.\\\\\\\")\\\\n            return 0\\\\n    db.remove(args.email)\\\\n    print(green(f\\\\\\\"🗑  {args.email} dihapus.\\\\\\\"))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_set(cfg, db, args):\\\\n    if not db.find(args.email):\\\\n        print(yellow(\\\\\\\"Akun tidak ditemukan.\\\\\\\"))\\\\n        return 1\\\\n    updates = {}\\\\n    if args.status:\\\\n        st = args.status.lower()\\\\n        if st not in (\\\\\\\"healthy\\\\\\\", \\\\\\\"unhealthy\\\\\\\", \\\\\\\"untested\\\\\\\"):\\\\n            print(red(\\\\\\\"Status harus: healthy / unhealthy / untested\\\\\\\"))\\\\n            return 1\\\\n        updates[\\\\\\\"status\\\\\\\"] = st\\\\n    if args.paused is not None:\\\\n        updates[\\\\\\\"paused\\\\\\\"] = args.paused.lower() in (\\\\\\\"1\\\\\\\", \\\\\\\"true\\\\\\\", \\\\\\\"yes\\\\\\\", \\\\\\\"ya\\\\\\\")\\\\n    if args.note is not None:\\\\n        updates[\\\\\\\"note\\\\\\\"] = args.note\\\\n    if args.password:\\\\n        updates[\\\\\\\"password\\\\\\\"] = args.password\\\\n    if not updates:\\\\n        print(yellow(\\\\\\\"Tidak ada perubahan yang diminta.\\\\\\\"))\\\\n        return 0\\\\n    db.update(args.email, **updates)\\\\n    print(green(f\\\\\\\"✅ {args.email} diperbarui: {updates}\\\\\\\"))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_stats(cfg, db, args):\\\\n    accounts = db.load()\\\\n    c = Counter(str(a.get(\\\\\\\"status\\\\\\\", \\\\\\\"untested\\\\\\\")) for a in accounts)\\\\n    total = len(accounts)\\\\n    paused = sum(1 for a in accounts if a.get(\\\\\\\"paused\\\\\\\"))\\\\n    last = max((a.get(\\\\\\\"last_check\\\\\\\") or \\\\\\\"\\\\\\\" for a in accounts), default=\\\\\\\"-\\\\\\\")\\\\n    print(bold(f\\\\\\\"📊 Total akun: {total}\\\\\\\"))\\\\n    for st in (\\\\\\\"healthy\\\\\\\", \\\\\\\"unhealthy\\\\\\\", \\\\\\\"untested\\\\\\\"):\\\\n        print(f\\\\\\\"  {status_icon(st)} {st}: {c.get(st, 0)}\\\\\\\")\\\\n    print(f\\\\\\\"  ✋ paused: {paused}\\\\\\\")\\\\n    print(f\\\\\\\"  🕒 check terakhir: {last}\\\\\\\")\\\\n    if c.get(\\\\\\\"healthy\\\\\\\"):\\\\n        print(bold(f\\\\\\\"Persentase sehat: {100.0 * c['healthy'] / total:.1f}%\\\\\\\"))\\\\n    return 0\\\\n\\\\n\\\\ndef cmd_tgtest(cfg, db, args):\\\\n    n = Notifier(cfg)\\\\n    if not n.enabled:\\\\n        print(yellow(\\\\\\\"Telegram belum dikonfigurasi. Isi config.json → telegram, atau env TG_BOT_TOKEN / TG_CHAT_ID. Lihat README.\\\\\\\"))\\\\n        return 1\\\\n    ok = n.send(\\\\\\\"✅ Test notifikasi dari <b>Ptero Akun Parent Manager</b>\\\\\\\")\\\\n    print(green(\\\\\\\"Terikirim ✅\\\\\\\") if ok else red(\\\\\\\"Gagal kirim ✖ — cek token/chat id dan log.\\\\\\\"))\\\\n    return 0 if ok else 1\\\\n\\\\n\\\\ndef build_parser():\\\\n    p = argparse.ArgumentParser(prog=\\\\\\\"main.py\\\\\\\", description=\\\\\\\"🎯 Bot Pterodactyl manajemen akun parent (cek kesehatan, auto-monitor, export akun sehat)\\\\\\\")\\\\n    sub = p.add_subparsers(dest=\\\\\\\"cmd\\\\\\\", metavar=\\\\\\\"perintah\\\\\\\")\\\\n\\\\n    a = sub.add_parser(\\\\\\\"add\\\\\\\", help=\\\\\\\"Tambah akun parent\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--email\\\\\\\", required=True)\\\\n    a.add_argument(\\\\\\\"--password\\\\\\\", required=True, help=\\\\\\\"Password atau app password (Gmail wajib app password)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--recovery\\\\\\\", help=\\\\\\\"Email recovery (outlook/proton/dll)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--proxy\\\\\\\", help=\\\\\\\"Proxy opsional, format: socks5://user:pass@host:port\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--imap-host\\\\\\\", help=\\\\\\\"Host IMAP kustom (default: imap.gmail.com)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--imap-port\\\\\\\", help=\\\\\\\"Port IMAP (default: 993)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--note\\\\\\\", help=\\\\\\\"Catatan (mis. nomor urut anak, dsb.)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--check\\\\\\\", action=\\\\\\\"store_true\\\\\\\", help=\\\\\\\"Langsung cek setelah ditambahkan\\\\\\\")\\\\n    a.set_defaults(func=cmd_add)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"list\\\\\\\", help=\\\\\\\"Lihat daftar akun\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--status\\\\\\\", choices=[\\\\\\\"healthy\\\\\\\", \\\\\\\"unhealthy\\\\\\\", \\\\\\\"untested\\\\\\\", \\\\\\\"all\\\\\\\"], default=\\\\\\\"all\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--limit\\\\\\\", type=int, help=\\\\\\\"Batasi jumlah baris\\\\\\\")\\\\n    a.set_defaults(func=cmd_list)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"check\\\\\\\", help=\\\\\\\"Cek sekali semua akun (manual)\\\\\\\")\\\\n    a.set_defaults(func=cmd_check)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"auto\\\\\\\", help=\\\\\\\"Mode monitor: cek berkala terus-menerus\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--interval\\\\\\\", type=int, help=\\\\\\\"Menit antar pengecekan (default dari config.json)\\\\\\\")\\\\n    a.set_defaults(func=cmd_auto)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"export\\\\\\\", help=\\\\\\\"Export akun (default: yang masih sehat)\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--status\\\\\\\", default=\\\\\\\"healthy\\\\\\\", help=\\\\\\\"healthy / unhealthy / untested / all\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--format\\\\\\\", choices=[\\\\\\\"csv\\\\\\\", \\\\\\\"json\\\\\\\", \\\\\\\"both\\\\\\\"], default=\\\\\\\"both\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--out\\\\\\\", help=\\\\\\\"Nama file output (untuk format tunggal)\\\\\\\")\\\\n    a.set_defaults(func=cmd_export)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"import\\\\\\\", help=\\\\\\\"Import massal dari CSV\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--file\\\\\\\", required=True, help=\\\\\\\"CSV kolom: email,password,recovery,proxy,imap_host,imap_port,note\\\\\\\")\\\\n    a.set_defaults(func=cmd_import)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"remove\\\\\\\", help=\\\\\\\"Hapus akun\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--email\\\\\\\", required=True)\\\\n    a.add_argument(\\\\\\\"--yes\\\\\\\", action=\\\\\\\"store_true\\\\\\\", help=\\\\\\\"Tanpa konfirmasi\\\\\\\")\\\\n    a.set_defaults(func=cmd_remove)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"set\\\\\\\", help=\\\\\\\"Ubah status / paused / note akun\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--email\\\\\\\", required=True)\\\\n    a.add_argument(\\\\\\\"--status\\\\\\\", help=\\\\\\\"healthy / unhealthy / untested\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--paused\\\\\\\", help=\\\\\\\"true/false — skip dari auto check\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--note\\\\\\\", help=\\\\\\\"Ganti catatan\\\\\\\")\\\\n    a.add_argument(\\\\\\\"--password\\\\\\\", help=\\\\\\\"Ganti password/app password\\\\\\\")\\\\n    a.set_defaults(func=cmd_set)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"stats\\\\\\\", help=\\\\\\\"Statistik database\\\\\\\")\\\\n    a.set_defaults(func=cmd_stats)\\\\n\\\\n    a = sub.add_parser(\\\\\\\"tg-test\\\\\\\", help=\\\\\\\"Kirim notifikasi uji ke Telegram\\\\\\\")\\\\n    a.set_defaults(func=cmd_tgtest)\\\\n\\\\n    return p\\\\n\\\\n\\\\ndef main():\\\\n    parser = build_parser()\\\\n    args = parser.parse_args()\\\\n    if not getattr(args, \\\\\\\"cmd\\\\\\\", None):\\\\n        parser.print_help()\\\\n        return 0\\\\n    cfg = load_config(CONFIG_PATH)\\\\n    db_path = cfg.get(\\\\\\\"db_file\\\\\\\") or DB_PATH\\\\n    if not os.path.isabs(db_path):\\\\n        db_path = os.path.join(APP_DIR, db_path)\\\\n    db = AccountDB(db_path)\\\\n    return args.func(cfg, db, args)\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    sys.exit(main())\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/main.py\\\"}\"}}, {\"id\": \"call_790f31874f7d4184ad0e71db\", \"call_id\": \"call_790f31874f7d4184ad0e71db\", \"response_item_id\": \"fc_790f31874f7d4184ad0e71db\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Penyimpanan data akun (JSON) dengan akses thread-safe.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport os\\\\nimport threading\\\\n\\\\nfrom .utils import now_iso\\\\n\\\\n\\\\nclass AccountDB:\\\\n    def __init__(self, path):\\\\n        self.path = path\\\\n        self._lock = threading.Lock()\\\\n        self._ensure()\\\\n\\\\n    def _ensure(self):\\\\n        if not os.path.exists(self.path):\\\\n            self.save([])\\\\n\\\\n    def load(self):\\\\n        with self._lock:\\\\n            try:\\\\n                with open(self.path, \\\\\\\"r\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\") as f:\\\\n                    data = json.load(f)\\\\n                return data if isinstance(data, list) else []\\\\n            except (json.JSONDecodeError, OSError):\\\\n                return []\\\\n\\\\n    def save(self, data):\\\\n        with self._lock:\\\\n            tmp = self.path + \\\\\\\".tmp\\\\\\\"\\\\n            with open(tmp, \\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\") as f:\\\\n                json.dump(data, f, indent=2, ensure_ascii=False)\\\\n            os.replace(tmp, self.path)\\\\n\\\\n    def find(self, email):\\\\n        email = (email or \\\\\\\"\\\\\\\").strip().lower()\\\\n        for acc in self.load():\\\\n            if str(acc.get(\\\\\\\"email\\\\\\\", \\\\\\\"\\\\\\\")).strip().lower() == email:\\\\n                return acc\\\\n        return None\\\\n\\\\n    def add(self, **fields):\\\\n        data = self.load()\\\\n        for acc in data:\\\\n            if str(acc.get(\\\\\\\"email\\\\\\\", \\\\\\\"\\\\\\\")).strip().lower() == fields[\\\\\\\"email\\\\\\\"].strip().lower():\\\\n                return False, acc\\\\n        acc = {\\\\n            \\\\\\\"email\\\\\\\": fields[\\\\\\\"email\\\\\\\"].strip(),\\\\n            \\\\\\\"password\\\\\\\": fields.get(\\\\\\\"password\\\\\\\") or \\\\\\\"\\\\\\\",\\\\n            \\\\\\\"recovery\\\\\\\": (fields.get(\\\\\\\"recovery\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n            \\\\\\\"proxy\\\\\\\": (fields.get(\\\\\\\"proxy\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n            \\\\\\\"imap_host\\\\\\\": (fields.get(\\\\\\\"imap_host\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n            \\\\\\\"imap_port\\\\\\\": fields.get(\\\\\\\"imap_port\\\\\\\") or \\\\\\\"\\\\\\\",\\\\n            \\\\\\\"note\\\\\\\": (fields.get(\\\\\\\"note\\\\\\\") or \\\\\\\"\\\\\\\").strip(),\\\\n            \\\\\\\"status\\\\\\\": \\\\\\\"untested\\\\\\\",\\\\n            \\\\\\\"fail_count\\\\\\\": 0,\\\\n            \\\\\\\"paused\\\\\\\": False,\\\\n            \\\\\\\"last_check\\\\\\\": \\\\\\\"\\\\\\\",\\\\n            \\\\\\\"created_at\\\\\\\": now_iso(),\\\\n        }\\\\n        data.append(acc)\\\\n        self.save(data)\\\\n        return True, acc\\\\n\\\\n    def update(self, email, **fields):\\\\n        data = self.load()\\\\n        email = (email or \\\\\\\"\\\\\\\").strip().lower()\\\\n        for acc in data:\\\\n            if str(acc.get(\\\\\\\"email\\\\\\\", \\\\\\\"\\\\\\\")).strip().lower() == email:\\\\n                acc.update(fields)\\\\n                self.save(data)\\\\n                return True, acc\\\\n        return False, None\\\\n\\\\n    def remove(self, email):\\\\n        data = self.load()\\\\n        before = len(data)\\\\n        target = (email or \\\\\\\"\\\\\\\").strip().lower()\\\\n        data = [a for a in data if str(a.get(\\\\\\\"email\\\\\\\", \\\\\\\"\\\\\\\")).strip().lower() != target]\\\\n        if len(data) != before:\\\\n            self.save(data)\\\\n            return True\\\\n        return False\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/database.py\\\"}\"}}, {\"id\": \"call_40b860cdc67e4064aeb8d097\", \"call_id\": \"call_40b860cdc67e4064aeb8d097\", \"response_item_id\": \"fc_40b860cdc67e4064aeb8d097\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Pemeriksa kesehatan akun parent via IMAP login (dukungan proxy SOCKS5).\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport imaplib\\\\nimport logging\\\\nimport socket\\\\nimport ssl\\\\nimport time\\\\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\\\\n\\\\nlog = logging.getLogger(\\\\\\\"health\\\\\\\")\\\\n\\\\n\\\\ndef parse_proxy(raw):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Format: socks5://user:pass@host:port -> dict(host, port, user, password)\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    if not raw:\\\\n        return None\\\\n    raw = str(raw).strip()\\\\n    rest = raw\\\\n    if \\\\\\\"://\\\\\\\" in rest:\\\\n        rest = rest.split(\\\\\\\"://\\\\\\\", 1)[1]\\\\n    user = password = None\\\\n    if \\\\\\\"@\\\\\\\" in rest:\\\\n        cred, rest = rest.rsplit(\\\\\\\"@\\\\\\\", 1)\\\\n        if \\\\\\\":\\\\\\\" in cred:\\\\n            user, password = cred.split(\\\\\\\":\\\\\\\", 1)\\\\n        else:\\\\n            user = cred\\\\n    host, port = rest.rsplit(\\\\\\\":\\\\\\\", 1)\\\\n    return {\\\\\\\"host\\\\\\\": host, \\\\\\\"port\\\\\\\": int(port), \\\\\\\"user\\\\\\\": user, \\\\\\\"password\\\\\\\": password}\\\\n\\\\n\\\\nclass SocksIMAP4SSL(imaplib.IMAP4_SSL):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"IMAP4_SSL yang koneksinya lewat proxy SOCKS5 (butuh Python >= 3.9).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, host, port, proxy, timeout=30):\\\\n        self._proxy = proxy or {}\\\\n        super().__init__(host, port, timeout=timeout)\\\\n\\\\n    def _create_socket(self, timeout):\\\\n        if timeout is not None and not timeout:\\\\n            raise ValueError(\\\\\\\"timeout=0 tidak didukung\\\\\\\")\\\\n        if self._proxy:\\\\n            import socks  # PySocks\\\\n\\\\n            s = socks.socksocket()\\\\n            s.set_proxy(\\\\n                socks.SOCKS5,\\\\n                self._proxy[\\\\\\\"host\\\\\\\"],\\\\n                self._proxy[\\\\\\\"port\\\\\\\"],\\\\n                username=self._proxy.get(\\\\\\\"user\\\\\\\"),\\\\n                password=self._proxy.get(\\\\\\\"password\\\\\\\"),\\\\n            )\\\\n            s.settimeout(timeout)\\\\n            log.debug(\\\\\\\"Koneksi IMAP via proxy %s:%s\\\\\\\", self._proxy[\\\\\\\"host\\\\\\\"], self._proxy[\\\\\\\"port\\\\\\\"])\\\\n            return s\\\\n        return socket.create_connection((self.host, self.port), timeout)\\\\n\\\\n\\\\ndef _elapsed(t0):\\\\n    return int((time.monotonic() - t0) * 1000)\\\\n\\\\n\\\\ndef check_one(acc, cfg):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Cek satu akun. Return: {status, detail, latency_ms}\\\\n    status: ok | auth_failed | timeout | conn_error | error\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    host = (acc.get(\\\\\\\"imap_host\\\\\\\") or \\\\\\\"\\\\\\\").strip() or cfg[\\\\\\\"imap\\\\\\\"][\\\\\\\"host\\\\\\\"]\\\\n    port = int((acc.get(\\\\\\\"imap_port\\\\\\\") or \\\\\\\"\\\\\\\").strip() or cfg[\\\\\\\"imap\\\\\\\"][\\\\\\\"port\\\\\\\"])\\\\n    timeout = int(cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"timeout_seconds\\\\\\\", 30))\\\\n    proxy = None\\\\n    if cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"use_proxy\\\\\\\") and acc.get(\\\\\\\"proxy\\\\\\\"):\\\\n        proxy = parse_proxy(acc[\\\\\\\"proxy\\\\\\\"])\\\\n\\\\n    t0 = time.monotonic()\\\\n    conn = None\\\\n    try:\\\\n        if proxy:\\\\n            conn = SocksIMAP4SSL(host, port, proxy, timeout=timeout)\\\\n        else:\\\\n            conn = imaplib.IMAP4_SSL(host, port, timeout=timeout)\\\\n        conn.login(acc[\\\\\\\"email\\\\\\\"], acc[\\\\\\\"password\\\\\\\"])\\\\n        try:\\\\n            conn.logout()\\\\n        except Exception:\\\\n            pass\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"ok\\\\\\\", \\\\\\\"detail\\\\\\\": \\\\\\\"login berhasil\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except imaplib.IMAP4.error as e:\\\\n        msg = str(e).replace(\\\\\\\"\\\\\\\\r\\\\\\\", \\\\\\\" \\\\\\\").replace(\\\\\\\"\\\\\\\\n\\\\\\\", \\\\\\\" \\\\\\\")[:140]\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"auth_failed\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"login ditolak: {msg}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except socket.timeout:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"timeout\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"timeout {timeout}s\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except (ssl.SSLError, OSError, ConnectionError) as e:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"conn_error\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"{type(e).__name__}: {str(e)[:100]}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    except Exception as e:\\\\n        return {\\\\\\\"status\\\\\\\": \\\\\\\"error\\\\\\\", \\\\\\\"detail\\\\\\\": f\\\\\\\"{type(e).__name__}: {str(e)[:100]}\\\\\\\", \\\\\\\"latency_ms\\\\\\\": _elapsed(t0)}\\\\n    finally:\\\\n        if conn:\\\\n            try:\\\\n                conn.shutdown()\\\\n            except Exception:\\\\n                pass\\\\n\\\\n\\\\ndef run_checks(accounts, cfg):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Cek semua akun (paralel). Hasil mengikuti urutan input.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    concurrency = int(cfg[\\\\\\\"check\\\\\\\"].get(\\\\\\\"concurrency\\\\\\\", 3))\\\\n    results = [None] * len(accounts)\\\\n    if concurrency <= 1 or len(accounts) <= 1:\\\\n        return [check_one(a, cfg) for a in accounts]\\\\n    with ThreadPoolExecutor(max_workers=concurrency) as pool:\\\\n        futs = {pool.submit(check_one, acc, cfg): i for i, acc in enumerate(accounts)}\\\\n        for fut in as_completed(futs):\\\\n            results[futs[fut]] = fut.result()\\\\n    return results\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/health.py\\\"}\"}}, {\"id\": \"call_3994e04b6b714031bad6813c\", \"call_id\": \"call_3994e04b6b714031bad6813c\", \"response_item_id\": \"fc_3994e04b6b714031bad6813c\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Notifikasi Telegram (opsional). Token/chat id dari config.json atau env\\\\nTG_BOT_TOKEN / TG_CHAT_ID (variabel egg Pterodactyl).\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport logging\\\\nimport os\\\\n\\\\nimport requests\\\\n\\\\nlog = logging.getLogger(\\\\\\\"notify\\\\\\\")\\\\n\\\\n\\\\nclass Notifier:\\\\n    def __init__(self, cfg):\\\\n        tg = cfg.get(\\\\\\\"telegram\\\\\\\", {})\\\\n        self.token = os.environ.get(\\\\\\\"TG_BOT_TOKEN\\\\\\\") or tg.get(\\\\\\\"bot_token\\\\\\\") or \\\\\\\"\\\\\\\"\\\\n        self.chat_id = os.environ.get(\\\\\\\"TG_CHAT_ID\\\\\\\") or str(tg.get(\\\\\\\"chat_id\\\\\\\") or \\\\\\\"\\\\\\\")\\\\n        self.enabled = bool(self.token and self.chat_id)\\\\n\\\\n    def send(self, text):\\\\n        if not self.enabled:\\\\n            return False\\\\n        try:\\\\n            r = requests.post(\\\\n                f\\\\\\\"https://api.telegram.org/bot{self.token}/sendMessage\\\\\\\",\\\\n                json={\\\\n                    \\\\\\\"chat_id\\\\\\\": self.chat_id,\\\\n                    \\\\\\\"text\\\\\\\": text,\\\\n                    \\\\\\\"parse_mode\\\\\\\": \\\\\\\"HTML\\\\\\\",\\\\n                    \\\\\\\"disable_web_page_preview\\\\\\\": True,\\\\n                },\\\\n                timeout=15,\\\\n            )\\\\n            ok = r.status_code == 200 and r.json().get(\\\\\\\"ok\\\\\\\")\\\\n            if not ok:\\\\n                log.warning(\\\\\\\"Telegram API: %s\\\\\\\", r.text[:200])\\\\n            return ok\\\\n        except Exception as e:\\\\n            log.warning(\\\\\\\"Gagal kirim Telegram: %s\\\\\\\", e)\\\\n            return False\\\\n\\\\n    @staticmethod\\\\n    def _esc(text):\\\\n        return str(text).replace(\\\\\\\"&\\\\\\\", \\\\\\\"&amp;\\\\\\\").replace(\\\\\\\"<\\\\\\\", \\\\\\\"&lt;\\\\\\\").replace(\\\\\\\">\\\\\\\", \\\\\\\"&gt;\\\\\\\")\\\\n\\\\n    def alert_status(self, email, old, new, reason, latency):\\\\n        if not self.enabled:\\\\n            return\\\\n        icon = \\\\\\\"✅\\\\\\\" if new == \\\\\\\"healthy\\\\\\\" else \\\\\\\"⚠️\\\\\\\"\\\\n        self.send(\\\\n            f\\\\\\\"{icon} <b>Status akun parent berubah</b>\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"📧 {self._esc(email)}\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Status: {self._esc(old)} → <b>{self._esc(new)}</b>\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Alasan: {self._esc(reason)}\\\\\\\\n\\\\\\\"\\\\n            f\\\\\\\"Latensi: {latency} ms\\\\\\\"\\\\n        )\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/notifier.py\\\"}\"}}, {\"id\": \"call_2cb4946181a4411c98b1c3ac\", \"call_id\": \"call_2cb4946181a4411c98b1c3ac\", \"response_item_id\": \"fc_2cb4946181a4411c98b1c3ac\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Export daftar akun (mis. yang masih sehat) ke CSV/JSON.\\\\n\\\\nCATATAN: file export berisi password — perlakukan seperti file rahasia\\\\n(chmod 600, jangan share sembarangan).\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport csv\\\\nimport json\\\\n\\\\nCSV_FIELDS = [\\\\n    \\\\\\\"email\\\\\\\", \\\\\\\"password\\\\\\\", \\\\\\\"recovery\\\\\\\", \\\\\\\"proxy\\\\\\\", \\\\\\\"imap_host\\\\\\\",\\\\n    \\\\\\\"note\\\\\\\", \\\\\\\"status\\\\\\\", \\\\\\\"last_check\\\\\\\", \\\\\\\"fail_count\\\\\\\",\\\\n]\\\\n\\\\n\\\\ndef export_accounts(accounts, path, fmt=\\\\\\\"csv\\\\\\\", statuses=None):\\\\n    statuses = statuses or []\\\\n    rows = [\\\\n        a for a in accounts\\\\n        if (not statuses) or str(a.get(\\\\\\\"status\\\\\\\", \\\\\\\"\\\\\\\")).lower() in statuses\\\\n    ]\\\\n    if fmt == \\\\\\\"json\\\\\\\":\\\\n        with open(path, \\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\") as f:\\\\n            json.dump(rows, f, indent=2, ensure_ascii=False)\\\\n    else:\\\\n        with open(path, \\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\", newline=\\\\\\\"\\\\\\\") as f:\\\\n            w = csv.DictWriter(f, fieldnames=CSV_FIELDS, extrasaction=\\\\\\\"ignore\\\\\\\")\\\\n            w.writeheader()\\\\n            w.writerows(rows)\\\\n    return len(rows)\\\", \\\"path\\\": \\\"/home/runner/ptero-akun-parent-manager/manager/exporter.py\\\"}\"}}, {\"id\": \"call_034f0955594f40b4bd463f3f\", \"call_id\": \"call_034f0955594f40b4bd463f3f\", \"response_item_id\": \"fc_034f0955594f40b4bd463f3f\", \"type\": \"function\", \"function\": {\"name\": \"write_file\", \"arguments\": \"{\\\"content\\\": \\\"# -*- coding: utf-8 -*-\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Utilitas kecil: config, waktu, tabel, ikon status.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport os\\\\nfrom datetime import datetime, timezone\\\\n\\\\nDEFAULT_CONFIG = {\\\\n    \\\\\\\"db_file\\\\\\\": \\\\\\\"accounts.json\\\\\\\",\\\\n    \\\\\\\"imap\\\\\\\": {\\\\n        \\\\\\\"host\\\\\\\": \\\\\\\"imap.gmail.com\\\\\\\",\\\\n        \\\\\\\"port\\\\\\\": 993,\\\\n    },\\\\n    \\\\\\\"check\\\\\\\": {\\\\n        \\\\\\\"interval_minutes\\\\\\\": 60,\\\\n        \\\\\\\"concurrency\\\\\\\": 3,\\\\n        \\\\\\\"timeout_seconds\\\\\\\": 30,\\\\n        \\\\\\\"consecutive_fail_threshold\\\\\\\": 1,\\\\n        \\\\\\\"use_proxy\\\\\\\": False,\\\\n    },\\\\n    \\\\\\\"telegram\\\\\\\": {\\\\n        \\\\\\\"enabled\\\\\\\": False,\\\\n        \\\\\\\"bot_token\\\\\\\": \\\\\\\"\\\\\\\",\\\\n        \\\\\\\"chat_id\\\\\\\": \\\\\\\"\\\\\\\",\\\\n    },\\\\n}\\\\n\\\\n\\\\ndef now_iso():\\\\n    return datetime.now(timezone.utc).astimezone().isoformat(timespec=\\\\\\\"seconds\\\\\\\")\\\\n\\\\n\\\\ndef mask_email(email):\\\\n    if not email:\\\\n        return \\\\\\\"-\\\\\\\"\\\\n    local, _, domain = str(email).partition(\\\\\\\"@\\\\\\\")\\\\n    if len(local) <= 3:\\\\n        return local[0] + \\\\\\\"***@\\\\\\\" + domain\\\\n    return local[:3] + \\\\\\\"***@\\\\\\\" + domain\\\\n\\\\n\\\\ndef load_config(path):\\\\n    if not os.path.exists(path):\\\\n        with open(path, \\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\") as f:\\\\n            json.dump(DEFAULT_CONFIG, f, indent=2, ensure_ascii=False)\\\\n    with open(path, \\\\\\\"r\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\") as f:\\\\n        return json.load(f)\\\\n\\\\n\\\\ndef status_icon(status):\\\\n    return {\\\\n        \\\\\\\"healthy\\\\\\\": \\\\\\\"✅\\\\\\\",\\\\n        \\\\\\\"unhealthy\\\\\\\": \\\\\\\"❌\\\\\\\",\\\\n        \\\\\\\"untested\\\\\\\": \\\\\\\"⬜\\\\\\\",\\\\n        \\\\\\\"checking\\\\\\\": \\\\\\\"🔄\\\\\\\",\\\\n    }.get(str(status).lower(), \\\\\\\"❔\\\\\\\")\\\\n\\\\n\\\\ndef print_table(headers, rows):\\\\n    if not rows:\\\\n        print(\\\\\\\"(kosong)\\\\\\\")\\\\n        return\\\\n    cols = len(headers)\\\\n    widths = [len(str(h)) for h in headers]\\\\n    for r in rows:\\\\n        for i in range(cols):\\\\n            widths[i] = max(widths[i], len(str(r[i] if i < len(r) else \\\\\\\"\\\\\\\")))\\\\n\\\\n    def fmt_row(cells):\\\\n        return \\\\\\\" | \\\\\\\".join(str(c).ljust(widths[i]) for i, c in enumerate(cells))\\\\n\\\\n    print(fmt_row(headers))\\\\n    print(\\\\\\\"-+-\\\\\\\".join(\\\\\\\"-\\\\\\\" * w for w in widths))\\\\n    for r in rows:\\\\n   